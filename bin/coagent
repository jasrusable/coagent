#!/usr/bin/env node
'use strict';

// coagent — the lead's standing colleague (Claude Code or Grok Build).
//
// Stack: human → lead agent → one co-agent per lead session
//
// Usage:
//   coagent [opts] "<message>"        enqueue on the standing thread, wait
//   coagent [opts] --interrupt "…"    stop the current turn, do this next
//   coagent status | watch | reset | sessions | resume <id> | log | search
//   coagent digest | lead | transcript | doctor | outbox

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { spawn, spawnSync } = require('child_process');

const HOME = os.homedir();
const ROOT = process.env.COAGENT_HOME || path.join(HOME, '.coagent');
const PERSONA_FILE = path.join(ROOT, 'persona.md');
const PERSONAS_DIR = path.join(ROOT, 'personas');
const STATE_DIR = path.join(ROOT, 'state');
const CLAUDE_PROJECTS = path.join(HOME, '.claude', 'projects');
const GROK_HOME = process.env.GROK_HOME || path.join(HOME, '.grok');
const GROK_SESSIONS = path.join(GROK_HOME, 'sessions');
const GROK_ACTIVE = path.join(GROK_HOME, 'active_sessions.json');
const VALID = new Set(['auto', 'claude', 'grok']);

function loadLib(name) {
  const installed = path.join(ROOT, 'lib', name);
  if (fs.existsSync(installed)) return require(installed);
  return require(path.join(__dirname, '..', 'lib', name));
}
const digestLib = loadLib('digest.js');
const S = loadLib('session.js');

const INHERITANCE_PREAMBLE = [
  'You inherit the lead agent\'s full instruction stack (global CLAUDE.md / AGENTS.md and any',
  'project CLAUDE.md/AGENTS.md, plus whatever the active harness loads) on top of this persona.',
  'Treat those as shared context — principles, conventions, and project knowledge the lead',
  'operates under. But they are written addressed to the lead, not you: where they tell "you"',
  'to consult, loop in, or background a message to the co-agent, that co-agent IS you — you have',
  'no co-agent of your own to consult, so do not act on those directions. You are the peer',
  'being referred to; just be that peer.',
  '',
  'You are the lead\'s standing colleague — one thread, same workspace. Lead with the bottom',
  'line; be direct; no filler.',
  '',
  'Outbox: for durable work products (long reviews, checklists, findings, plans), write files',
  'under the outbox directory you are given. Chat reply = short summary + full path(s).',
].join(' ');

const fail = (msg) => { console.error(`coagent: ${msg}`); process.exit(1); };
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const isAlive = S.isAlive;

function childPidsOf(pid) {
  try {
    const r = spawnSync('pgrep', ['-P', String(pid)], { encoding: 'utf8' });
    if (r.status !== 0 && r.status !== 1) return [];
    return String(r.stdout || '').split(/\s+/).map((s) => parseInt(s, 10)).filter((n) => Number.isFinite(n) && n > 1);
  } catch { return []; }
}

async function killTree(pid) {
  if (!pid || pid === process.pid) return;
  const stack = [pid];
  const seen = new Set();
  const all = [];
  while (stack.length) {
    const p = stack.pop();
    if (!p || seen.has(p)) continue;
    seen.add(p);
    all.push(p);
    for (const c of childPidsOf(p)) stack.push(c);
  }
  for (const p of all.reverse()) { try { process.kill(p, 'SIGTERM'); } catch { /* */ } }
  for (let i = 0; i < 30; i++) { if (!all.some(isAlive)) break; await sleep(50); }
  for (const p of all.reverse()) {
    if (isAlive(p)) { try { process.kill(p, 'SIGKILL'); } catch { /* */ } }
  }
}

fs.mkdirSync(STATE_DIR, { recursive: true });

const digestMdPath = (leadSid) => path.join(S.leadDir(STATE_DIR, leadSid), 'context.md');
const digestJsonPath = (leadSid) => path.join(S.leadDir(STATE_DIR, leadSid), 'context.json');

function outboxDir(leadSid, genId, create = true) {
  const d = path.join(S.genDir(STATE_DIR, leadSid, genId, create), 'outbox');
  if (create) S.ensureDir(d);
  return d;
}

function lastReplyPath(leadSid, genId) {
  return path.join(S.genDir(STATE_DIR, leadSid, genId, false), 'last_reply.md');
}
function lastReplyMetaPath(leadSid, genId) {
  return path.join(S.genDir(STATE_DIR, leadSid, genId, false), 'last_reply.json');
}

function listOutbox(leadSid, genId) {
  const dir = outboxDir(leadSid, genId, false);
  if (!fs.existsSync(dir)) return [];
  const entries = [];
  for (const name of fs.readdirSync(dir)) {
    if (name.startsWith('.')) continue;
    const p = path.join(dir, name);
    let st; try { st = fs.statSync(p); } catch { continue; }
    if (!st.isFile()) continue;
    entries.push({ name, path: p, size: st.size, mtimeMs: st.mtimeMs, mtime: st.mtime.toISOString() });
  }
  entries.sort((a, b) => b.mtimeMs - a.mtimeMs);
  return entries;
}

function formatOutboxListing(entries, { limit = 20 } = {}) {
  if (!entries.length) return '(empty)';
  return entries.slice(0, limit).map((e) => {
    const kb = e.size < 1024 ? `${e.size}B` : `${(e.size / 1024).toFixed(1)}K`;
    return `${e.name}  ${kb}  ${ageLabel(e.mtimeMs)}  ${e.path}`;
  }).join('\n') + (entries.length > limit ? `\n… +${entries.length - limit} more` : '');
}

function ageLabel(isoOrMs) {
  if (isoOrMs == null) return null;
  const t = typeof isoOrMs === 'number' ? isoOrMs : Date.parse(isoOrMs);
  if (!Number.isFinite(t)) return null;
  const sec = Math.max(0, Math.round((Date.now() - t) / 1000));
  if (sec < 60) return `${sec}s ago`;
  if (sec < 3600) return `${Math.round(sec / 60)}m ago`;
  if (sec < 86400) return `${Math.round(sec / 3600)}h ago`;
  return `${Math.round(sec / 86400)}d ago`;
}

function clip(s, n) {
  return digestLib.clip(s, n, HOME);
}

function printHelp() {
  console.log(`coagent — the lead's standing colleague (one per harness session)

Usage:
  coagent [opts] "<message>"              enqueue, wait for this reply (resumes)
  coagent [opts] --interrupt "<message>"  stop the current turn, do this next
  coagent status                          current gen, queue, last reply
  coagent watch [-f] [--timeout N]        live tail of the colleague
  coagent reset                           archive this gen, start a fresh transcript
  coagent sessions                        list generations
  coagent resume <id>                     make an old gen current
  coagent log                             consults in the current gen
  coagent search "<query>"                search this session's generations
  coagent digest | lead | transcript | doctor | outbox

Options:
  --lead, -l    auto|claude|grok
  --model, -m   <spec>     this-turn override (claude, grok, grok-4.6, claude/opus, …)
                           default: the lead's current model
  --persona     <name|path>
  --clear-queue            with --interrupt: drop remaining queued items
  --raw                    print answer body only
  --timeout N              wait N seconds (default 600)
  --follow, -f             watch: keep following
  --help, -h

  (--peer / ask / --backend are rejected)

Env: COAGENT_HOME, COAGENT_MODEL, COAGENT_LEAD, COAGENT_PERSONA,
     COAGENT_LEAD_TRANSCRIPT, COAGENT_LEAD_SESSION_ID,
     GROK_SESSION_ID, CLAUDE_CODE_SESSION_ID
Home: ${ROOT}
`);
}

function parseArgs(argv) {
  let lead = null;
  let modelSpec = null;
  let persona = null;
  let follow = false;
  let raw = false;
  let interrupt = false;
  let clearQueue = false;
  let timeoutSec = null;
  const rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') return { help: true };
    if (a === '--backend' || a === '-b' || a.startsWith('--backend=')) {
      fail('use --model instead of --backend (e.g. --model grok-4.6 or --model claude)');
    }
    if (a === '--peer' || a.startsWith('--peer=')) {
      fail('one co-agent per lead session. Resume: coagent "…". Fresh tape: coagent reset');
    }
    if (a === '--lead' || a === '-l') { lead = argv[++i]; continue; }
    if (a.startsWith('--lead=')) { lead = a.slice(7); continue; }
    if (a === '--model' || a === '-m') { modelSpec = argv[++i]; continue; }
    if (a.startsWith('--model=')) { modelSpec = a.slice(8); continue; }
    if (a === '--persona') { persona = argv[++i]; continue; }
    if (a.startsWith('--persona=')) { persona = a.slice(10); continue; }
    if (a === '--interrupt') { interrupt = true; continue; }
    if (a === '--clear-queue') { clearQueue = true; continue; }
    if (a === '--follow' || a === '-f') { follow = true; continue; }
    if (a === '--raw') { raw = true; continue; }
    if (a === '--timeout') { timeoutSec = Number(argv[++i]); continue; }
    if (a.startsWith('--timeout=')) { timeoutSec = Number(a.slice(10)); continue; }
    if (a === '--parallel' || a === '--save') {
      fail(`${a} is gone. Messages resume the standing thread; --model/--persona apply to this turn`);
    }
    if (a.startsWith('-') && a !== '-') fail(`unknown option ${a} (try --help)`);
    rest.push(a);
  }
  return { lead, modelSpec, persona, follow, raw, interrupt, clearQueue, timeoutSec, rest };
}

function normalizeChoice(v, label) {
  if (v == null || v === '') return 'auto';
  const n = String(v).toLowerCase().trim();
  if (!VALID.has(n)) fail(`${label} must be auto|claude|grok (got ${v})`);
  return n;
}

/** backend/id, harness name, or a raw model id (grok-4.6, claude-opus-…). */
function parseModelSpec(spec) {
  if (spec == null || spec === '') {
    return { backendChoice: null, modelId: null, raw: null };
  }
  const s = String(spec).trim();
  if (!s) return { backendChoice: null, modelId: null, raw: null };

  if (s.includes('/')) {
    const i = s.indexOf('/');
    const be = s.slice(0, i).trim();
    const modelId = s.slice(i + 1).trim() || null;
    const backendChoice = normalizeChoice(be, '--model backend');
    if (backendChoice === 'auto') fail('--model auto/… is not valid; use claude/… or grok/…');
    if (!modelId) fail(`--model ${s}: missing model id after /`);
    return { backendChoice, modelId, raw: s };
  }

  const lower = s.toLowerCase();
  if (VALID.has(lower)) {
    return { backendChoice: normalizeChoice(s, '--model'), modelId: null, raw: s };
  }
  const backendChoice = lower.startsWith('claude') ? 'claude'
    : (lower.startsWith('grok') ? 'grok' : null);
  return { backendChoice, modelId: s, raw: s };
}

function resolvePersonaPath(flagOrSticky) {
  if (!flagOrSticky) return PERSONA_FILE;
  const v = String(flagOrSticky).trim();
  if (!v) return PERSONA_FILE;
  if (v.startsWith('/') || v.startsWith('~') || v.includes('/')) {
    return v.startsWith('~') ? path.join(HOME, v.slice(1)) : v;
  }
  const candidates = [
    path.join(PERSONAS_DIR, `${v}.md`),
    path.join(PERSONAS_DIR, v),
    path.join(ROOT, `${v}.md`),
    v,
  ];
  for (const c of candidates) {
    if (fs.existsSync(c)) return c;
  }
  fail(`persona not found: ${v} (tried ${candidates.slice(0, 3).join(', ')})`);
}

function loadPersona(personaPath) {
  const p = personaPath || PERSONA_FILE;
  if (!fs.existsSync(p)) fail(`no persona at ${p}`);
  const raw = fs.readFileSync(p, 'utf8');
  const m = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  const meta = {};
  let body = raw;
  if (m) {
    body = m[2];
    for (const line of m[1].split('\n')) {
      const kv = line.match(/^(\w+):\s*(.*)$/);
      if (kv) meta[kv[1]] = kv[2].trim();
    }
  }
  return {
    path: p,
    effort: meta.effort || 'high',
    model: meta.model || null,
    backend: meta.backend || null,
    lead: meta.lead || null,
    permissionMode: meta.permissionMode || 'bypassPermissions',
    allowedTools: meta.allowedTools || null,
    disallowedTools: meta.disallowedTools || null,
    mcp: meta.mcp || 'on',
    persona: body.trim(),
  };
}

function ancestorPids() {
  const out = [];
  let pid = process.pid;
  for (let i = 0; i < 48; i++) {
    out.push(pid);
    let ppid;
    try {
      const r = spawnSync('ps', ['-p', String(pid), '-o', 'ppid='], { encoding: 'utf8' });
      ppid = parseInt(String(r.stdout || '').trim(), 10);
    } catch { break; }
    if (!Number.isFinite(ppid) || ppid <= 1 || ppid === pid) break;
    pid = ppid;
  }
  return out;
}

function findClaudeTranscriptBySid(sid) {
  if (!sid || !fs.existsSync(CLAUDE_PROJECTS)) return null;
  for (const d of fs.readdirSync(CLAUDE_PROJECTS)) {
    const t = path.join(CLAUDE_PROJECTS, d, `${sid}.jsonl`);
    if (fs.existsSync(t)) return t;
  }
  return null;
}

function claudeProjectDirForCwd(cwd) {
  if (!cwd || !fs.existsSync(CLAUDE_PROJECTS)) return null;
  const slug = cwd.replace(/[^A-Za-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const exact = path.join(CLAUDE_PROJECTS, slug);
  if (fs.existsSync(exact)) return exact;
  const dashed = cwd.replace(/^\//, '').replace(/\//g, '-');
  const p = path.join(CLAUDE_PROJECTS, dashed);
  if (fs.existsSync(p)) return p;
  return null;
}

function findClaudeTranscriptByCwd() {
  const dir = claudeProjectDirForCwd(process.cwd());
  if (!dir) return null;
  let best = null;
  let bestM = 0;
  for (const f of fs.readdirSync(dir)) {
    if (!f.endsWith('.jsonl')) continue;
    const t = path.join(dir, f);
    try {
      const m = fs.statSync(t).mtimeMs;
      if (m > bestM) { bestM = m; best = t; }
    } catch { /* */ }
  }
  return best;
}

function resolveClaudeLead(explicitSid) {
  const sid = explicitSid || process.env.CLAUDE_CODE_SESSION_ID || null;
  if (sid) {
    const t = findClaudeTranscriptBySid(sid);
    if (t) return { harness: 'claude', sessionId: sid, transcriptPath: t, pin: 'env' };
  }
  const t = findClaudeTranscriptByCwd();
  if (t) {
    return {
      harness: 'claude',
      sessionId: path.basename(t).replace(/\.jsonl$/, ''),
      transcriptPath: t,
      pin: 'cwd-mtime',
    };
  }
  return null;
}

function encodeGrokCwd(cwd) { return encodeURIComponent(cwd); }

function grokSessionDir(sessionId, cwd) {
  if (cwd) {
    const p = path.join(GROK_SESSIONS, encodeGrokCwd(cwd), sessionId);
    if (fs.existsSync(p)) return p;
  }
  if (!fs.existsSync(GROK_SESSIONS)) return null;
  for (const d of fs.readdirSync(GROK_SESSIONS)) {
    const p = path.join(GROK_SESSIONS, d, sessionId);
    if (fs.existsSync(p)) return p;
  }
  return null;
}

function readGrokActive() {
  if (!fs.existsSync(GROK_ACTIVE)) return [];
  try {
    const raw = JSON.parse(fs.readFileSync(GROK_ACTIVE, 'utf8'));
    return Array.isArray(raw) ? raw : (raw.sessions || []);
  } catch { return []; }
}

function cwdChain() {
  const chain = [];
  let cur = process.cwd();
  for (let i = 0; i < 20; i++) {
    chain.push(cur);
    const parent = path.dirname(cur);
    if (parent === cur) break;
    cur = parent;
  }
  return chain;
}

function injectGrokSessionEnv(sessionId) {
  if (!sessionId) return;
  if (!process.env.GROK_SESSION_ID) process.env.GROK_SESSION_ID = sessionId;
  if (!process.env.COAGENT_LEAD_SESSION_ID) process.env.COAGENT_LEAD_SESSION_ID = sessionId;
}

function resolveGrokLead(explicitSid) {
  const envSid = explicitSid || process.env.GROK_SESSION_ID || process.env.COAGENT_LEAD_SESSION_ID || null;
  if (envSid) {
    const dir = grokSessionDir(envSid, process.cwd()) || grokSessionDir(envSid);
    if (dir) {
      injectGrokSessionEnv(envSid);
      return {
        harness: 'grok',
        sessionId: envSid,
        transcriptPath: path.join(dir, 'updates.jsonl'),
        pin: process.env.GROK_SESSION_ID === envSid ? 'env' : 'coagent-env',
        sessionDir: dir,
      };
    }
  }

  const active = readGrokActive();
  const ancestors = new Set(ancestorPids());
  const byAncestor = active
    .filter((s) => s && s.session_id && s.pid && ancestors.has(s.pid) && isAlive(s.pid));
  if (byAncestor.length > 1) {
    fail(`ambiguous Grok lead: ${byAncestor.length} sessions in ancestry`);
  }
  if (byAncestor.length === 1) {
    const s = byAncestor[0];
    const dir = grokSessionDir(s.session_id, s.cwd);
    if (dir) {
      injectGrokSessionEnv(s.session_id);
      return {
        harness: 'grok',
        sessionId: s.session_id,
        transcriptPath: path.join(dir, 'updates.jsonl'),
        pin: 'ancestor-pid',
        sessionDir: dir,
      };
    }
  }

  const chain = cwdChain();
  const byCwd = active
    .filter((s) => s && s.session_id && s.cwd && chain.includes(s.cwd) && (!s.pid || isAlive(s.pid)));
  if (byCwd.length > 1) {
    fail(`ambiguous Grok lead: ${byCwd.length} active sessions for this cwd`);
  }
  if (byCwd.length === 1) {
    const s = byCwd[0];
    const dir = grokSessionDir(s.session_id, s.cwd);
    if (dir) {
      injectGrokSessionEnv(s.session_id);
      return {
        harness: 'grok',
        sessionId: s.session_id,
        transcriptPath: path.join(dir, 'updates.jsonl'),
        pin: 'cwd-active',
        sessionDir: dir,
      };
    }
  }
  return null;
}

function leadFromExplicitTranscript(transcriptPath) {
  if (!transcriptPath || !fs.existsSync(transcriptPath)) return null;
  if (transcriptPath.includes(`${path.sep}updates.jsonl`) || transcriptPath.endsWith('updates.jsonl')) {
    const sessionId = path.basename(path.dirname(transcriptPath));
    injectGrokSessionEnv(sessionId);
    return {
      harness: 'grok',
      sessionId,
      transcriptPath,
      pin: 'explicit-path',
      sessionDir: path.dirname(transcriptPath),
    };
  }
  if (transcriptPath.endsWith('.jsonl')) {
    return {
      harness: 'claude',
      sessionId: path.basename(transcriptPath).replace(/\.jsonl$/, ''),
      transcriptPath,
      pin: 'explicit-path',
    };
  }
  return null;
}

function resolveLead(leadChoice) {
  const explicit = process.env.COAGENT_LEAD_TRANSCRIPT || process.env.PANEL_TRANSCRIPT || null;
  if (explicit) {
    const L = leadFromExplicitTranscript(explicit);
    if (L) return L;
  }
  const sidHint = process.env.COAGENT_LEAD_SESSION_ID || null;

  if (leadChoice === 'claude') {
    const L = resolveClaudeLead(sidHint);
    if (L) return L;
  }
  if (leadChoice === 'grok') {
    const L = resolveGrokLead(sidHint || process.env.GROK_SESSION_ID);
    if (L) return L;
  }
  if (leadChoice === 'auto') {
    if (process.env.CLAUDE_CODE_SESSION_ID) {
      const L = resolveClaudeLead(process.env.CLAUDE_CODE_SESSION_ID);
      if (L) return L;
    }
    if (process.env.GROK_SESSION_ID) {
      const L = resolveGrokLead(process.env.GROK_SESSION_ID);
      if (L) return L;
    }
    if (process.env.GROK_AGENT) {
      const L = resolveGrokLead(null);
      if (L) return L;
    }
    const g = resolveGrokLead(null);
    if (g) return g;
    const c = resolveClaudeLead(null);
    if (c) return c;
  }
  fail('no lead conversation found. Need GROK_SESSION_ID or CLAUDE_CODE_SESSION_ID.');
}

function loadClaudeRecords(transcriptPath) {
  if (!transcriptPath || !fs.existsSync(transcriptPath)) return [];
  const out = [];
  for (const line of fs.readFileSync(transcriptPath, 'utf8').split('\n')) {
    if (!line.trim()) continue;
    try { out.push(JSON.parse(line)); } catch { /* */ }
  }
  return out;
}

function loadGrokUpdates(transcriptPath) {
  if (!transcriptPath || !fs.existsSync(transcriptPath)) return [];
  const out = [];
  for (const line of fs.readFileSync(transcriptPath, 'utf8').split('\n')) {
    if (!line.trim()) continue;
    try {
      const o = JSON.parse(line);
      if (o.method !== 'session/update' && o.method !== '_x.ai/session/update') continue;
      const params = o.params || {};
      const meta = params._meta || {};
      out.push({
        eventId: meta.eventId || o.eventId || null,
        update: params.update || {},
        timestamp: o.timestamp,
        method: o.method,
      });
    } catch { /* */ }
  }
  return out;
}

function detectLeadModel(lead) {
  if (lead.harness === 'grok') {
    const dir = lead.sessionDir || grokSessionDir(lead.sessionId, process.cwd()) || grokSessionDir(lead.sessionId);
    return S.detectGrokLeadModel(dir);
  }
  return S.detectClaudeLeadModel(loadClaudeRecords(lead.transcriptPath));
}

function buildDigest(lead, genId, sinceMarker) {
  const records = lead.harness === 'claude'
    ? loadClaudeRecords(lead.transcriptPath)
    : loadGrokUpdates(lead.transcriptPath);

  const result = digestLib.buildDigestFromRecords({
    harness: lead.harness,
    records,
    sinceMarker,
    home: HOME,
    outboxIndex: listOutbox(lead.sessionId, genId).map((e) => ({
      name: e.name, size: e.size, mtime: e.mtime, path: e.path,
    })),
    transcriptPath: lead.transcriptPath,
    pin: lead.pin || null,
  });

  const digestPath = digestMdPath(lead.sessionId);
  const jsonPath = digestJsonPath(lead.sessionId);
  S.atomicWrite(digestPath, result.markdown);
  S.writeJson(jsonPath, {
    lead: lead.harness,
    sessionId: lead.sessionId,
    pin: lead.pin || null,
    transcriptPath: lead.transcriptPath,
    genId,
    isDelta: result.isDelta,
    lastMarker: result.lastMarker,
    sinceMarker: sinceMarker || null,
    fallbackNote: result.fallbackNote || null,
    snapshot: result.side,
    outbox: result.side.outbox || [],
    updatedAt: new Date().toISOString(),
  });

  return {
    digestPath,
    jsonPath,
    lastMarker: result.lastMarker,
    isDelta: result.isDelta,
    side: result.side,
    fallbackNote: result.fallbackNote,
    hardFallback: result.hardFallback,
  };
}

function runCmd(cmd, args, onSpawn) {
  return new Promise((resolve) => {
    const childEnv = { ...process.env };
    delete childEnv.GROK_AGENT;
    delete childEnv.COAGENT_BG_WORKER;
    const child = spawn(cmd, args, {
      cwd: process.cwd(),
      env: childEnv,
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    if (onSpawn) onSpawn(child.pid);
    let out = '';
    let err = '';
    child.stdout.on('data', (d) => { out += d; });
    child.stderr.on('data', (d) => { err += d; });
    child.on('close', (code) => resolve({ code, out, err }));
  });
}

function parsePeerResult(backend, out) {
  let answer = (out || '').trim();
  let sessionId = null;
  let durMs = null;
  let subtype = null;
  let stopReason = null;
  let isError = false;
  try {
    const j = JSON.parse(out);
    if (backend === 'claude') {
      answer = j.result || j.answer || answer;
      sessionId = j.session_id || j.sessionId || null;
      subtype = j.subtype || null;
      isError = !!j.is_error;
      durMs = j.duration_ms || null;
      stopReason = j.stop_reason || null;
    } else {
      let text = j.result || j.answer || j.text || null;
      if (!text && j.message) {
        text = typeof j.message === 'string' ? j.message
          : (j.message.content || j.message.text || null);
      }
      if (text != null) answer = typeof text === 'string' ? text : JSON.stringify(text);
      sessionId = j.sessionId || j.session_id || null;
      subtype = j.subtype || j.stopReason || null;
      isError = !!j.isError || !!j.is_error;
      durMs = j.durationMs || j.duration_ms || null;
      stopReason = j.stopReason || j.stop_reason || null;
    }
  } catch { /* plain text */ }
  return { answer, sessionId, durMs, subtype, stopReason, isError };
}

function systemBundle(personaBody) {
  return `${INHERITANCE_PREAMBLE}\n\n${personaBody}`;
}

function buildClaudeArgs({ prompt, effort, model, permissionMode, allowedTools, disallowedTools, mcp, persona, sessionId, resume }) {
  const base = [
    '-p', prompt,
    '--output-format', 'json',
    '--effort', effort,
    '--permission-mode', permissionMode,
    '--add-dir', STATE_DIR,
  ];
  if (allowedTools) base.push('--allowedTools', ...allowedTools.split(/[\s,]+/).filter(Boolean));
  if (disallowedTools) base.push('--disallowedTools', ...disallowedTools.split(/[\s,]+/).filter(Boolean));
  if (mcp === 'off') base.push('--strict-mcp-config');
  if (model) base.push('--model', model);
  if (resume) return [...base, '--resume', sessionId];
  return [...base, '--session-id', sessionId, '--append-system-prompt', systemBundle(persona)];
}

function buildGrokArgs({ prompt, effort, model, permissionMode, allowedTools, disallowedTools, persona, sessionId, resume }) {
  const base = [
    '-p', prompt,
    '--output-format', 'json',
    '--effort', effort,
    '--permission-mode', permissionMode,
    '--always-approve',
    '--rules', systemBundle(persona),
  ];
  if (allowedTools) base.push('--tools', allowedTools.split(/[\s,]+/).filter(Boolean).join(','));
  if (disallowedTools) base.push('--disallowed-tools', disallowedTools.split(/[\s,]+/).filter(Boolean).join(','));
  if (model) base.push('--model', model);
  if (resume) return [...base, '--resume', sessionId];
  return [...base, '--session-id', sessionId];
}

function findPeerTranscript(backend, peerSessionId) {
  if (!peerSessionId) return null;
  if (backend === 'claude') {
    if (!fs.existsSync(CLAUDE_PROJECTS)) return null;
    return fs.readdirSync(CLAUDE_PROJECTS)
      .map((d) => path.join(CLAUDE_PROJECTS, d, `${peerSessionId}.jsonl`))
      .find((p) => fs.existsSync(p)) || null;
  }
  const dir = grokSessionDir(peerSessionId, process.cwd()) || grokSessionDir(peerSessionId);
  return dir ? path.join(dir, 'updates.jsonl') : null;
}

function whichBin(name) {
  try {
    const r = spawnSync('which', [name], { encoding: 'utf8' });
    return r.status === 0 ? String(r.stdout || '').trim() : null;
  } catch { return null; }
}

function writeReplyFiles(leadSid, genId, { answer, meta, message, backend, peerSessionId, itemId }) {
  const header = [
    `# Co-agent reply`,
    ``,
    `**When:** ${new Date().toISOString()}`,
    `**Generation:** ${genId}`,
    `**Backend:** ${backend}`,
    peerSessionId ? `**Session:** ${peerSessionId}` : '',
    itemId ? `**Item:** ${itemId}` : '',
    message ? `**Asked:** ${clip(message, 300)}` : '',
    ``,
    answer,
    ``,
    meta ? `---\n_${meta}_` : '',
  ].filter(Boolean).join('\n');

  S.atomicWrite(lastReplyPath(leadSid, genId), header);
  S.writeJson(lastReplyMetaPath(leadSid, genId), {
    at: new Date().toISOString(),
    genId,
    backend,
    peerSessionId: peerSessionId || null,
    itemId: itemId || null,
    message: message || null,
    answer,
    answerPreview: clip(answer, 400),
    meta: meta || null,
  });
  return { body: answer, wrapped: header };
}

function resolveContext(cli) {
  const defaultPersona = loadPersona(PERSONA_FILE);
  const leadChoice = normalizeChoice(cli.lead ?? process.env.COAGENT_LEAD ?? defaultPersona.lead, 'lead');
  const lead = resolveLead(leadChoice);
  const genId = S.ensureCurrent(STATE_DIR, lead.sessionId);
  const meta = S.loadMeta(STATE_DIR, lead.sessionId, genId);

  const personaPath = resolvePersonaPath(
    cli.persona || process.env.COAGENT_PERSONA || meta.personaPath || null,
  );
  const persona = loadPersona(personaPath);
  const leadModel = detectLeadModel(lead);
  const callSpec = parseModelSpec(cli.modelSpec ?? process.env.COAGENT_MODEL ?? null);

  let backendChoice = callSpec.backendChoice
    || (persona.backend ? normalizeChoice(persona.backend, 'persona backend') : null)
    || 'auto';
  backendChoice = normalizeChoice(backendChoice, 'backend');
  const backend = backendChoice === 'auto' ? lead.harness : backendChoice;

  let model = null;
  if (callSpec.raw != null) {
    model = callSpec.modelId;
  } else if (backend === lead.harness && leadModel.modelId) {
    model = leadModel.modelId;
  } else if (persona.model && backend === (persona.backend || backend)) {
    model = persona.model;
  }

  let effort = persona.effort;
  if (!cli.modelSpec && leadModel.effort && backend === lead.harness) {
    effort = leadModel.effort;
  }

  if (lead.pin === 'cwd-mtime') {
    console.error('coagent: warning: pinned by newest transcript in this tree — may be another window');
  }

  return {
    persona,
    personaPath,
    lead,
    backend,
    model,
    effort,
    genId,
    meta,
    leadModel,
  };
}

function buildPrompt({ dig, lead, backend, message, leadSid, genId }) {
  const box = outboxDir(leadSid, genId);
  const existing = listOutbox(leadSid, genId);
  const existingNote = existing.length
    ? [
        `Existing outbox files:`,
        ...existing.slice(0, 15).map((e) => `  - ${e.name} (${ageLabel(e.mtimeMs)}, ${e.size}B)`),
      ].join('\n')
    : 'Outbox is currently empty.';

  return [
    `You are the lead agent's standing colleague (full capability, shared workspace).`,
    `Generation: ${genId}.`,
    ``,
    `Shared lead context (user ⇄ lead — read first):`,
    `  ${dig.digestPath}`,
    dig.jsonPath ? `Structured snapshot JSON: ${dig.jsonPath}` : '',
    `Outbox: ${box}`,
    existingNote,
    `Write durable artifacts to the outbox. Reply: short summary + full path(s).`,
    `Raw lead transcript: ${lead.transcriptPath}`,
    ``,
    `Lead harness: ${lead.harness} (pin=${lead.pin || '?'}). Backend: ${backend}.`,
    ``,
    `The lead agent says:`,
    message,
  ].filter(Boolean).join('\n');
}

async function runTurn(ctx, item) {
  const { persona, lead, backend, model, effort, genId } = ctx;
  const mainSid = lead.sessionId;
  let meta = S.loadMeta(STATE_DIR, mainSid, genId);

  if (meta.sessionId && meta.backend && meta.backend !== backend) {
    meta = { ...meta, sessionId: null, lastUuid: null };
    S.saveMeta(STATE_DIR, mainSid, meta);
  }

  const existing = !!meta.sessionId;
  const dig = buildDigest(lead, genId, existing ? meta.lastUuid : null);
  const prompt = buildPrompt({
    dig, lead, backend, message: item.message, leadSid: mainSid, genId,
  });

  const common = {
    prompt,
    effort: effort || persona.effort,
    model: model || null,
    permissionMode: persona.permissionMode,
    allowedTools: persona.allowedTools,
    disallowedTools: persona.disallowedTools,
    mcp: persona.mcp,
    persona: persona.persona,
  };

  const mkNew = () => {
    const sid = crypto.randomUUID();
    const args = backend === 'claude'
      ? buildClaudeArgs({ ...common, sessionId: sid, resume: false })
      : buildGrokArgs({ ...common, sessionId: sid, resume: false });
    return { sid, args };
  };

  let run = existing
    ? {
        sid: meta.sessionId,
        args: backend === 'claude'
          ? buildClaudeArgs({ ...common, sessionId: meta.sessionId, resume: true })
          : buildGrokArgs({ ...common, sessionId: meta.sessionId, resume: true }),
      }
    : mkNew();

  const stamp = (sid) => (childPid) => {
    S.writeWorker(STATE_DIR, mainSid, genId, {
      pid: process.pid,
      childPid,
      itemId: item.id,
      sessionId: sid,
    });
  };

  const cmd = backend === 'claude' ? 'claude' : 'grok';
  let res = await runCmd(cmd, run.args, stamp(run.sid));

  const latest = S.findItem(STATE_DIR, mainSid, genId, item.id);
  if (latest && latest.status === 'interrupted') return { interrupted: true };

  if (res.code !== 0 && existing) {
    const fresh = mkNew();
    const retry = await runCmd(cmd, fresh.args, stamp(fresh.sid));
    const again = S.findItem(STATE_DIR, mainSid, genId, item.id);
    if (again && again.status === 'interrupted') return { interrupted: true };
    if (retry.code === 0) { run = fresh; res = retry; }
  }

  if (res.code !== 0) {
    const err = (res.err || res.out || '').trim().slice(0, 800);
    return { failed: true, error: err, code: res.code };
  }

  const parsed = parsePeerResult(backend, res.out);
  if (parsed.sessionId) run.sid = parsed.sessionId;

  const status = parsed.subtype
    ? (parsed.isError ? `⚠ ${parsed.subtype}` : parsed.subtype)
    : (parsed.isError ? '⚠ error' : null);
  const dur = parsed.durMs != null ? `${(parsed.durMs / 1000).toFixed(1)}s` : null;
  const tpath = findPeerTranscript(backend, run.sid);
  const bits = [
    `lead=${lead.harness}`,
    `model=${model || backend}`,
    `gen=${genId}`,
    `item=${item.id}`,
    status,
    parsed.stopReason,
    dur,
    dig.hardFallback && `fallback:${dig.fallbackNote}`,
    tpath && `transcript: ${tpath}`,
  ].filter(Boolean).join(' · ');

  writeReplyFiles(mainSid, genId, {
    answer: parsed.answer,
    meta: bits,
    message: item.message,
    backend,
    peerSessionId: run.sid,
    itemId: item.id,
  });

  S.saveMeta(STATE_DIR, mainSid, {
    ...S.loadMeta(STATE_DIR, mainSid, genId),
    sessionId: run.sid,
    lastUuid: dig.lastMarker || meta.lastUuid || null,
    backend,
    model: model || null,
    lastQuestion: item.message,
    lastQuestionAt: new Date().toISOString(),
    lastError: null,
    lastMeta: bits,
    personaPath: persona.path,
  });

  return { answer: parsed.answer, meta: bits, sessionId: run.sid };
}

async function processQueue(ctx) {
  const { lead, genId } = ctx;
  const mainSid = lead.sessionId;
  for (;;) {
    const next = S.nextQueued(STATE_DIR, mainSid, genId);
    if (!next) return;
    S.updateItem(STATE_DIR, mainSid, genId, next.id, {
      status: 'running',
      startedAt: new Date().toISOString(),
    });
    S.writeWorker(STATE_DIR, mainSid, genId, {
      pid: process.pid,
      childPid: null,
      itemId: next.id,
    });
    const result = await runTurn(ctx, next);
    const now = S.findItem(STATE_DIR, mainSid, genId, next.id);
    if (now && now.status === 'interrupted') continue;
    if (result.interrupted) continue;
    if (result.failed) {
      S.updateItem(STATE_DIR, mainSid, genId, next.id, {
        status: 'failed',
        finishedAt: new Date().toISOString(),
        error: result.error,
      });
      S.saveMeta(STATE_DIR, mainSid, {
        ...S.loadMeta(STATE_DIR, mainSid, genId),
        lastError: result.error,
      });
      continue;
    }
    S.updateItem(STATE_DIR, mainSid, genId, next.id, {
      status: 'done',
      finishedAt: new Date().toISOString(),
      error: null,
    });
  }
}

async function becomeWorkerAndDrain(ctx) {
  const { lead, genId } = ctx;
  const mainSid = lead.sessionId;
  if (!S.tryLock(STATE_DIR, mainSid, genId, process.pid)) return false;
  try {
    await processQueue(ctx);
  } finally {
    S.releaseLock(STATE_DIR, mainSid, genId, process.pid);
    const w = S.readWorker(STATE_DIR, mainSid, genId);
    if (w && w.pid === process.pid) {
      S.writeWorker(STATE_DIR, mainSid, genId, { pid: null, childPid: null, itemId: null });
    }
  }
  return true;
}

async function waitForItem(leadSid, genId, itemId, timeoutSec, ctx) {
  const timeoutMs = (timeoutSec != null ? timeoutSec : 600) * 1000;
  const start = Date.now();
  while (Date.now() - start < timeoutMs) {
    const item = S.findItem(STATE_DIR, leadSid, genId, itemId);
    if (!item) fail(`item ${itemId} disappeared`);
    if (item.status === 'done') return item;
    if (item.status === 'failed') fail(`co-agent failed: ${item.error || 'unknown'}`);
    if (item.status === 'interrupted') fail(`item ${itemId} was interrupted`);
    if (item.status === 'queued' && !S.workerAlive(STATE_DIR, leadSid, genId) && ctx) {
      await becomeWorkerAndDrain(ctx);
      continue;
    }
    await sleep(250);
  }
  fail(`timed out after ${timeoutSec || 600}s waiting for item ${itemId}`);
}

async function killCurrentChild(leadSid, genId) {
  const w = S.readWorker(STATE_DIR, leadSid, genId);
  if (w && w.childPid && isAlive(w.childPid)) await killTree(w.childPid);
}

async function cmdSend(message, cli) {
  const ctx = resolveContext(cli);
  const { lead, genId } = ctx;
  const mainSid = lead.sessionId;

  if (cli.interrupt) {
    S.interruptRunning(STATE_DIR, mainSid, genId, { clearQueue: cli.clearQueue });
    await killCurrentChild(mainSid, genId);
  }

  const item = S.enqueue(STATE_DIR, mainSid, genId, message, { front: !!cli.interrupt });
  if (!S.workerAlive(STATE_DIR, mainSid, genId)) {
    await becomeWorkerAndDrain(ctx);
  }
  const done = await waitForItem(mainSid, genId, item.id, cli.timeoutSec, ctx);
  const replyMeta = S.readJson(lastReplyMetaPath(mainSid, genId), {});
  if (cli.raw) {
    process.stdout.write((replyMeta.answer || '') + (String(replyMeta.answer || '').endsWith('\n') ? '' : '\n'));
    return;
  }
  if (fs.existsSync(lastReplyPath(mainSid, genId))) {
    const body = fs.readFileSync(lastReplyPath(mainSid, genId), 'utf8');
    if (replyMeta.itemId === done.id || !replyMeta.itemId) {
      process.stdout.write(body.endsWith('\n') ? body : `${body}\n`);
    } else {
      console.log(replyMeta.answer || '(done)');
    }
  } else {
    console.log(replyMeta.answer || '(done)');
  }
  if (replyMeta.meta) console.log(`\n↳ ${replyMeta.meta}`);
  console.log(`↳ reply: ${lastReplyPath(mainSid, genId)}`);
}

function cmdStatus(cli) {
  const ctx = resolveContext(cli);
  const { lead, backend, model, effort, genId, meta, leadModel } = ctx;
  const inbox = S.loadInbox(STATE_DIR, lead.sessionId, genId);
  const live = inbox.filter((i) => i.status === 'queued' || i.status === 'running');
  const w = S.readWorker(STATE_DIR, lead.sessionId, genId);
  const workerOn = S.workerAlive(STATE_DIR, lead.sessionId, genId);

  console.log(`co-agent: lead=${lead.harness} (${lead.sessionId}) · pin=${lead.pin || '?'}`);
  console.log(`  generation: ${genId}${meta.archivedAt ? ' (archived?)' : ''}`);
  console.log(`  model: ${model || '(default)'}  backend=${backend}  effort=${effort || '?'}`);
  if (leadModel.modelId) console.log(`  lead model: ${leadModel.modelId}${leadModel.effort ? ` · effort=${leadModel.effort}` : ''}`);
  console.log(`  thread: ${meta.sessionId || '(none)'}`);
  console.log(`  worker: ${workerOn ? `pid=${w && w.pid}` : 'idle'}${w && w.childPid ? ` child=${w.childPid}` : ''}`);
  if (live.length) {
    console.log('  queue:');
    for (const i of live) {
      console.log(`    ${i.id}  ${i.status}  ${clip(i.message, 80)}`);
    }
  } else {
    console.log('  queue: empty');
  }
  if (meta.lastQuestion) {
    console.log(`  last ask (${ageLabel(meta.lastQuestionAt) || '?'}): ${clip(meta.lastQuestion, 160)}`);
  }
  if (meta.lastError) console.log(`  last error: ${clip(meta.lastError, 200)}`);
  if (meta.lastMeta) console.log(`  last meta: ${meta.lastMeta}`);
  console.log(`  lead transcript: ${lead.transcriptPath}`);
  if (meta.sessionId) {
    const tp = findPeerTranscript(meta.backend || backend, meta.sessionId);
    if (tp) console.log(`  coagent transcript: ${tp}`);
  }
  if (fs.existsSync(lastReplyPath(lead.sessionId, genId))) {
    console.log(`  last reply: ${lastReplyPath(lead.sessionId, genId)} (${ageLabel(fs.statSync(lastReplyPath(lead.sessionId, genId)).mtimeMs)})`);
  }
  const box = listOutbox(lead.sessionId, genId);
  console.log(`  outbox: ${outboxDir(lead.sessionId, genId, false)} (${box.length})`);
  const gens = S.listGenIds(STATE_DIR, lead.sessionId);
  if (gens.length > 1) console.log(`  generations: ${gens.length} (coagent sessions)`);
}

function cmdSessions(cli) {
  const ctx = resolveContext(cli);
  const ids = S.listGenIds(STATE_DIR, ctx.lead.sessionId);
  if (!ids.length) { console.log('no generations yet'); return; }
  const cur = S.readCurrent(STATE_DIR, ctx.lead.sessionId);
  for (const id of ids) {
    const m = S.loadMeta(STATE_DIR, ctx.lead.sessionId, id);
    const inbox = S.loadInbox(STATE_DIR, ctx.lead.sessionId, id);
    const done = inbox.filter((i) => i.status === 'done').length;
    const mark = id === cur ? '*' : ' ';
    const state = m.archivedAt ? 'archived' : 'current';
    console.log(
      `${mark} ${id}  ${state}` +
      `${m.model ? `  ${m.backend || ''}/${m.model}` : (m.backend ? `  ${m.backend}` : '')}` +
      `  ${done} consults` +
      `${m.lastQuestionAt ? `  ${ageLabel(m.lastQuestionAt)}` : ''}` +
      `${m.lastQuestion ? `  ${clip(m.lastQuestion, 50)}` : ''}`,
    );
  }
}

function cmdResume(cli, genId) {
  if (!genId) fail('usage: coagent resume <generation-id>');
  const ctx = resolveContext(cli);
  const meta = S.resumeGeneration(STATE_DIR, ctx.lead.sessionId, genId);
  if (!meta) fail(`unknown generation: ${genId}`);
  console.log(`co-agent: resumed ${genId}`);
  console.log(`  thread: ${meta.sessionId || '(none — next message starts one)'}`);
}

function cmdReset(cli) {
  const ctx = resolveContext(cli);
  const old = S.readCurrent(STATE_DIR, ctx.lead.sessionId);
  const id = S.startGeneration(STATE_DIR, ctx.lead.sessionId);
  console.log(`co-agent: archived ${old || '(none)'}, started ${id}`);
  console.log('  old transcript kept. resume it with: coagent resume <id>');
}

function cmdLog(cli) {
  const ctx = resolveContext(cli);
  const inbox = S.loadInbox(STATE_DIR, ctx.lead.sessionId, ctx.genId);
  if (!inbox.length) { console.log('no consults in this generation'); return; }
  for (const i of inbox) {
    console.log(
      `${i.id}  ${i.status}` +
      `${i.finishedAt ? `  ${ageLabel(i.finishedAt)}` : (i.createdAt ? `  ${ageLabel(i.createdAt)}` : '')}` +
      `  ${clip(i.message, 80)}`,
    );
  }
}

function cmdSearch(cli, query) {
  if (!query) fail('usage: coagent search "<query>"');
  const ctx = resolveContext(cli);
  const hits = S.searchGens(STATE_DIR, ctx.lead.sessionId, query);
  if (!hits.length) { console.log('no matches'); return; }
  for (const h of hits.slice(0, 50)) {
    console.log(`${h.genId}${h.archived ? ' (archived)' : ''}  ${path.basename(h.file)}:${h.line}  ${h.text}`);
  }
  if (hits.length > 50) console.log(`… +${hits.length - 50} more`);
}

function cmdLead(cli) {
  const ctx = resolveContext(cli);
  console.log(JSON.stringify({
    lead: ctx.lead.harness,
    leadSessionId: ctx.lead.sessionId,
    leadTranscript: ctx.lead.transcriptPath,
    pin: ctx.lead.pin || null,
    genId: ctx.genId,
    model: ctx.model || null,
    leadModel: ctx.leadModel,
    backend: ctx.backend,
    grokSessionEnv: process.env.GROK_SESSION_ID || null,
  }, null, 2));
}

function cmdDigest(cli) {
  const ctx = resolveContext(cli);
  const dig = buildDigest(ctx.lead, ctx.genId, ctx.meta.lastUuid || null);
  console.log(`lead=${ctx.lead.harness} backend=${ctx.backend} gen=${ctx.genId} pin=${ctx.lead.pin || '?'}`);
  console.log(`digest: ${dig.digestPath}`);
  console.log(`json: ${dig.jsonPath}`);
  console.log(`lastMarker: ${dig.lastMarker}`);
  console.log(`delta: ${dig.isDelta}${dig.fallbackNote ? ` · fallback: ${dig.fallbackNote}` : ''}`);
  console.log(`thread: ${ctx.meta.sessionId || '(none)'}`);
  const text = fs.readFileSync(dig.digestPath, 'utf8');
  const lines = text.split('\n');
  console.log('--- digest preview ---');
  console.log(lines.slice(0, 50).join('\n'));
  if (lines.length > 50) console.log(`… (${lines.length - 50} more lines, ${text.length} chars)`);
}

function cmdTranscript(cli) {
  const ctx = resolveContext(cli);
  const p = findPeerTranscript(ctx.meta.backend || ctx.backend, ctx.meta.sessionId);
  if (!p) fail('no co-agent transcript yet (send a message first)');
  console.log(p);
}

function cmdOutbox(cli, args) {
  const ctx = resolveContext(cli);
  const sub = (args[0] || 'list').toLowerCase();
  const dir = outboxDir(ctx.lead.sessionId, ctx.genId);
  if (sub === 'path' || sub === 'dir') { console.log(dir); return; }
  if (sub === 'list' || sub === 'ls') {
    console.log(`outbox (gen ${ctx.genId}): ${dir}`);
    console.log(formatOutboxListing(listOutbox(ctx.lead.sessionId, ctx.genId)));
    return;
  }
  if (sub === 'cat' || sub === 'show' || sub === 'read') {
    const name = args[1];
    if (!name) fail('usage: coagent outbox cat <file>');
    const p = path.join(dir, path.basename(name));
    if (!fs.existsSync(p)) fail(`no outbox file: ${path.basename(name)}`);
    const body = fs.readFileSync(p, 'utf8');
    process.stdout.write(body);
    if (!body.endsWith('\n')) console.log('');
    return;
  }
  const p = path.join(dir, path.basename(sub));
  if (fs.existsSync(p) && fs.statSync(p).isFile()) {
    process.stdout.write(fs.readFileSync(p, 'utf8'));
    return;
  }
  fail(`unknown outbox subcommand "${sub}" (list | path | cat <file>)`);
}

function cmdDoctor(cli) {
  const defaultPersona = loadPersona(PERSONA_FILE);
  console.log('coagent doctor');
  console.log(`  home: ${ROOT}`);
  console.log(`  binary: ${__filename}`);
  console.log(`  persona: ${PERSONA_FILE} (${fs.existsSync(PERSONA_FILE) ? 'ok' : 'MISSING'})`);
  console.log(`  digest lib: ${path.join(ROOT, 'lib', 'digest.js')} (${fs.existsSync(path.join(ROOT, 'lib', 'digest.js')) ? 'ok' : 'MISSING'})`);
  console.log(`  session lib: ${path.join(ROOT, 'lib', 'session.js')} (${fs.existsSync(path.join(ROOT, 'lib', 'session.js')) ? 'ok' : 'MISSING'})`);
  console.log(`  claude cli: ${whichBin('claude') || 'NOT FOUND'}`);
  console.log(`  grok cli: ${whichBin('grok') || 'NOT FOUND'}`);
  console.log(`  env GROK_AGENT: ${process.env.GROK_AGENT || '(unset)'}`);
  console.log(`  env GROK_SESSION_ID: ${process.env.GROK_SESSION_ID || '(unset)'}`);
  try {
    const ctx = resolveContext(cli || {});
    console.log(`  lead: ${ctx.lead.harness} ${ctx.lead.sessionId}`);
    console.log(`  pin: ${ctx.lead.pin}`);
    console.log(`  lead model: ${ctx.leadModel.modelId || '(unknown)'}${ctx.leadModel.effort ? ` · ${ctx.leadModel.effort}` : ''}`);
    console.log(`  using: ${ctx.backend} ${ctx.model || '(cli default)'} · effort=${ctx.effort}`);
    console.log(`  generation: ${ctx.genId}`);
    console.log(`  thread: ${ctx.meta.sessionId || '(none)'}`);
    console.log(`  queue: ${S.loadInbox(STATE_DIR, ctx.lead.sessionId, ctx.genId).filter((i) => i.status === 'queued' || i.status === 'running').length}`);
    console.log(`  generations: ${S.listGenIds(STATE_DIR, ctx.lead.sessionId).length}`);
    console.log(`  persona effort (file): ${defaultPersona.effort}`);
  } catch (e) {
    console.log(`  lead resolve: FAIL — ${e.message || e}`);
  }
}

async function cmdWatch(cli, intervalSec) {
  const ctx = resolveContext(cli);
  const { lead, backend, genId, meta } = ctx;
  let b = meta.backend || backend;
  let p = findPeerTranscript(b, meta.sessionId);
  const interval = Math.max(0.2, intervalSec || 1) * 1000;
  const follow = !!cli.follow;
  const deadline = cli.timeoutSec != null && cli.timeoutSec > 0
    ? Date.now() + cli.timeoutSec * 1000
    : null;

  if (!p && !follow) {
    console.log('co-agent: no thread/transcript yet');
    return;
  }

  let offset = 0;
  if (p && fs.existsSync(p)) offset = fs.statSync(p).size;
  console.log(`watching gen ${genId} · ${p || '(waiting)'} · follow=${follow}`);

  while (true) {
    if (deadline && Date.now() > deadline) return;
    const m = S.loadMeta(STATE_DIR, lead.sessionId, genId);
    b = m.backend || backend;
    p = findPeerTranscript(b, m.sessionId);
    if (p && fs.existsSync(p)) {
      const { lines, size } = peerEventsSince(b, p, offset);
      for (const ln of lines) console.log(ln);
      offset = size;
    }
    const busy = S.workerAlive(STATE_DIR, lead.sessionId, genId)
      || S.loadInbox(STATE_DIR, lead.sessionId, genId).some((i) => i.status === 'running' || i.status === 'queued');
    if (!follow && !busy) {
      if (p && fs.existsSync(p)) {
        const { lines, size } = peerEventsSince(b, p, offset);
        for (const ln of lines) console.log(ln);
        offset = size;
      }
      console.log(`\n_(idle · reply: ${lastReplyPath(lead.sessionId, genId)})_`);
      return;
    }
    await sleep(interval);
  }
}

function peerEventsSince(backend, transcriptPath, sinceByte) {
  if (!transcriptPath || !fs.existsSync(transcriptPath)) return { lines: [], size: 0 };
  const st = fs.statSync(transcriptPath);
  const size = st.size;
  if (sinceByte >= size) return { lines: [], size };
  const fd = fs.openSync(transcriptPath, 'r');
  try {
    const len = size - sinceByte;
    const buf = Buffer.alloc(len);
    fs.readSync(fd, buf, 0, len, sinceByte);
    let chunk = buf.toString('utf8');
    if (sinceByte > 0 && !chunk.startsWith('\n') && chunk.includes('\n')) {
      chunk = chunk.slice(chunk.indexOf('\n') + 1);
    }
    const lines = [];
    for (const line of chunk.split('\n').filter(Boolean)) {
      let rec; try { rec = JSON.parse(line); } catch { continue; }
      if (backend === 'claude') {
        if (rec.isSidechain) continue;
        const c = rec.message && rec.message.content;
        if (rec.type === 'assistant' && Array.isArray(c)) {
          for (const part of c) {
            if (part.type === 'text' && part.text) lines.push(`● ${clip(digestLib.stripNoise(part.text), 200)}`);
            else if (part.type === 'tool_use') {
              lines.push(`  ↳ ${part.name}${digestLib.summarizeToolInput(part.input, HOME)}`);
            }
          }
        }
      } else if (rec.method === 'session/update') {
        const u = (rec.params && rec.params.update) || {};
        const kind = u.sessionUpdate;
        if (kind === 'agent_message_chunk') {
          const t = digestLib.stripNoise(digestLib.textFromContent(u.content));
          if (t) lines.push(`● ${clip(t, 200)}`);
        } else if (kind === 'tool_call') {
          const name = (u._meta && u._meta['x.ai/tool'] && u._meta['x.ai/tool'].name) || u.title || 'tool';
          lines.push(`  ↳ ${name}${digestLib.summarizeToolInput(u.rawInput || {}, HOME)}`);
        } else if (kind === 'tool_call_update' && (u.status === 'completed' || u.status === 'failed')) {
          const t = digestLib.stripNoise(digestLib.textFromContent(u.content));
          if (t) lines.push(`      → ${clip(t, 160)}`);
        }
      }
    }
    return { lines, size };
  } finally {
    fs.closeSync(fd);
  }
}

async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (parsed.help) { printHelp(); return; }
  const cli = {
    lead: parsed.lead,
    modelSpec: parsed.modelSpec,
    persona: parsed.persona,
    follow: parsed.follow,
    raw: parsed.raw,
    interrupt: parsed.interrupt,
    clearQueue: parsed.clearQueue,
    timeoutSec: parsed.timeoutSec,
  };
  const rest = parsed.rest;
  const verb = rest[0];

  const verbs = new Set([
    'status', 'reset', 'sessions', 'resume', 'log', 'search',
    'lead', 'digest', 'transcript', 'doctor', 'outbox', 'watch',
    'ask', 'peers', 'rm', 'bg', 'join', 'jobs',
  ]);

  if (!verb) fail('usage: coagent [options] "<message>" | status | reset | …  (try --help)');

  if (verb === 'ask' || verb === 'peers' || verb === 'rm' || verb === 'bg' || verb === 'join' || verb === 'jobs') {
    fail('one standing co-agent now. Send: coagent "…". Fresh tape: coagent reset. Interrupt: coagent --interrupt "…"');
  }
  if (verb === 'status') return cmdStatus(cli);
  if (verb === 'sessions') return cmdSessions(cli);
  if (verb === 'resume') return cmdResume(cli, rest[1]);
  if (verb === 'reset') return cmdReset(cli);
  if (verb === 'log') return cmdLog(cli);
  if (verb === 'search') return cmdSearch(cli, rest.slice(1).join(' '));
  if (verb === 'lead') return cmdLead(cli);
  if (verb === 'digest') return cmdDigest(cli);
  if (verb === 'transcript') return cmdTranscript(cli);
  if (verb === 'doctor') return cmdDoctor(cli);
  if (verb === 'outbox') return cmdOutbox(cli, rest.slice(1));
  if (verb === 'watch') {
    let interval;
    for (const a of rest.slice(1)) {
      if (!Number.isNaN(Number(a))) { interval = Number(a); break; }
    }
    return cmdWatch(cli, interval);
  }

  await cmdSend(rest.join(' '), cli);
}

if (require.main === module) {
  main().catch((e) => fail(e && e.stack ? e.stack : String(e)));
}

module.exports = {
  buildDigest,
  resolveLead,
  parseModelSpec,
  detectLeadModel,
  digestLib,
  session: S,
};
