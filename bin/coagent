#!/usr/bin/env node
'use strict';

// coagent — the lead agent's inner agent.
//
// you → lead (grok or claude) → inner agent (grok, claude, opus, or fable).
// Lead harness is derived from the environment. Inner family follows --model.

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { spawn, spawnSync } = require('child_process');

const HOME = os.homedir();
const ROOT = process.env.COAGENT_HOME || path.join(HOME, '.coagent');
const PERSONA_FILE = path.join(ROOT, 'persona.md');
const STATE_DIR = path.join(ROOT, 'state');
const DEFAULT_WAIT_SEC = 600;
const VERBS = new Set([
  'later', 'stop', 'wait', 'watch', 'log', 'reset', 'sessions', 'resume',
  'status', 'now', 'doctor', 'help', 'agents', 'notify', 'pings',
  'ask', 'answer', 'asks',
]);
// Well under the harness cap on a single blocking command; past it the worker
// parks instead and the tape is resumed later.
const ASK_WAIT_SEC = 90;
const DEFAULT_AGENT = 'main';
const MAX_AGENTS = 6;
const AGENT_RE = /^[a-z0-9][a-z0-9_-]{0,31}$/i;
const EFFORTS = new Set(['minimal', 'low', 'medium', 'high', 'xhigh', 'max']);

function loadLib(name) {
  const installed = path.join(ROOT, 'lib', name);
  if (fs.existsSync(installed)) return require(installed);
  return require(path.join(__dirname, '..', 'lib', name));
}
const S = loadLib('session.js');
const R = loadLib('render.js');
const H = loadLib('harness/index.js');

function fail(msg) {
  const text = `coagent: ${msg}`;
  if (require.main !== module) throw new Error(text);
  console.error(text);
  process.exit(1);
}
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function childPidsOf(pid) {
  try {
    const r = spawnSync('pgrep', ['-P', String(pid)], { encoding: 'utf8' });
    if (r.status !== 0 && r.status !== 1) return [];
    return String(r.stdout || '').split(/\s+/).map((s) => parseInt(s, 10)).filter((n) => Number.isFinite(n) && n > 1);
  } catch { return []; }
}

async function killTree(pid) {
  if (!pid || pid === process.pid) return;
  const stack = [pid];
  const seen = new Set();
  const all = [];
  while (stack.length) {
    const p = stack.pop();
    if (!p || seen.has(p)) continue;
    seen.add(p);
    all.push(p);
    for (const c of childPidsOf(p)) stack.push(c);
  }
  for (const p of all.reverse()) { try { process.kill(p, 'SIGTERM'); } catch { /* */ } }
  for (let i = 0; i < 30; i++) { if (!all.some(S.isAlive)) break; await sleep(50); }
  for (const p of all.reverse()) {
    if (S.isAlive(p)) { try { process.kill(p, 'SIGKILL'); } catch { /* */ } }
  }
}

fs.mkdirSync(STATE_DIR, { recursive: true });

function printHelp() {
  console.log(`coagent — the lead agent's inner agent (one per harness session)

Usage:
  coagent "…"                    send (interrupts if busy); returns immediately
  coagent later "…"              queue for after the current turn
  coagent stop                   kill the running turn; queue stays
  coagent wait [--timeout N]     stream until idle; print turns that finished
  coagent wait <id>              stream until that turn finishes; print it
  coagent                        snapshot (status + recent consults)
  coagent log                    consults (your messages + inner replies)
  coagent watch [-f]             live tail of the inner transcript
  coagent reset                  new tape for @main (named colleagues keep theirs)
  coagent @name reset            new tape for that colleague (old tape stays on disk)
  coagent sessions               inner sessions for this lead
  coagent resume <id>            make an old inner session current

Colleagues (parallel):
  coagent @review "…"            address a named colleague (starts one)
  coagent @review --brief-file b.md   brief from a file (no shell parsing)
  coagent @review - < b.md       brief from stdin
  coagent @review "new focus…"   steering: a busy colleague is interrupted
  coagent agents                 who exists, doing what, elapsed and spend
  coagent pings                  new worker flags since you last read
  coagent pings --all            the whole ping log
  coagent pings --follow         stream new flags as they arrive
  coagent asks                   questions workers are blocked on (full text)
  coagent asks <id>              one question, answered or not
  coagent answer <id> "…"        unblock one
  coagent wait --all             wait for every colleague; print as each lands

Inside a worker (only these; the lead's verbs are refused):
  coagent notify "…"             flag the lead mid-job, without blocking
  coagent ask "…"                block on a question; prints the answer
  coagent pings                  what other workers have flagged

Options:
  --agent, -a   <name>   address a colleague (same as @name; default main)
  --all                  wait: every colleague, printing each as it settles
  --model, -m   <id>     this-turn model override
  --effort, -e  <level>  this-turn effort override (minimal|low|medium|high|xhigh|max)
  --cwd         <dir>    this colleague's directory (sticky; a change starts a new tape)
  --readonly             read-only (sticky). --read-write clears it
  --brief-file <path>    read the message from a file ("-" = stdin)
  --timeout N            wait N seconds (wait only; default ${DEFAULT_WAIT_SEC})
  --follow, -f           watch: keep following after idle
  --help, -h

  Send is background. Ctrl-C on wait/watch does not stop the inner agent.
  Busy send = steer (interrupt). Use \`later\` to queue.
  \`coagent reset\` clears @main. \`coagent @name reset\` clears that colleague.
  The default bypasses approvals. \`--readonly\` does not: Grok gets the
  read-only sandbox and dontAsk; Claude gets dontAsk, write tools and MCP
  removed, and a prompt is denied instead of asked.

  Prefer --brief-file for anything long: a brief passed as an argument is
  parsed by your shell first, and backticks in it are command substitution.

  The lead harness is derived from the environment (Grok vs Claude Code).
  Inner agents can be a different family: \`--model fable\` / \`opus\` /
  \`claude-*\` drives Claude; \`grok-*\` drives Grok. \`coagent doctor\`
  shows the lead. Switching family on a colleague starts a new tape.

  @main follows the lead's model and effort unless you pass --model /
  --effort. Named colleagues can default via persona frontmatter —
  \`workerModel:\` / \`workerEffort:\` for all of them, \`model.<agent>:\` /
  \`effort.<agent>:\` for one (cross-family ids are allowed).

Env: COAGENT_HOME, COAGENT_MODEL, COAGENT_EFFORT, COAGENT_CWD, COAGENT_ACCESS,
     COAGENT_WORKER_MODEL, COAGENT_WORKER_EFFORT, COAGENT_LEAD_SESSION_ID,
     COAGENT_LEAD_TRANSCRIPT, GROK_SESSION_ID, CLAUDE_CODE_SESSION_ID
Home: ${ROOT}
`);
}

function parseEffort(v, flag) {
  const effort = String(v || '').trim().toLowerCase();
  if (!EFFORTS.has(effort)) {
    fail(`${flag} needs one of ${[...EFFORTS].join(', ')} (got ${v})`);
  }
  return effort;
}

function resolveEffort({ asked, policy, lead, persona }) {
  return asked || policy || lead || persona || null;
}

function resolveWorkdir(raw) {
  if (!raw) return null;
  const abs = path.resolve(String(raw));
  let st;
  try { st = fs.statSync(abs); } catch {
    fail(`no such directory ${raw}`);
  }
  if (!st.isDirectory()) fail(`${raw} is not a directory`);
  // The process's cwd is the real path. The session is stored under the
  // directory the child actually runs in, so a symlink and its target must
  // not become two tapes.
  try { return fs.realpathSync(abs); } catch { return abs; }
}

function resolveAccess({ asked, env, stored }) {
  if (asked === 'read-only' || asked === 'full') return asked;
  if (env === 'read-only' || env === 'full') return env;
  if (stored === 'read-only' || stored === 'full') return stored;
  return 'full';
}

// A grok or claude session is stored under the directory it was started in,
// and a grok sandbox profile is fixed for that session. Resuming across either
// change does not open the tape you think it does.
function resumeDecision({ meta, harnessId, cwd, access }) {
  if (!meta || !meta.sessionId) return { resume: false, reason: null };
  if (meta.harness && meta.harness !== harnessId) {
    return { resume: false, reason: `switching ${meta.harness} → ${harnessId}` };
  }
  if (meta.cwd && cwd && path.resolve(meta.cwd) !== path.resolve(cwd)) {
    return { resume: false, reason: `switching directory ${meta.cwd} → ${cwd}` };
  }
  const prev = meta.access || 'full';
  const next = access || 'full';
  if (prev !== next) return { resume: false, reason: `switching ${prev} → ${next}` };
  return { resume: true, reason: null };
}

function parseArgs(argv) {
  let agentName = null;
  let all = false;
  let model = null;
  let effort = null;
  let follow = false;
  let timeoutSec = null;
  let worker = false;
  let briefFile = null;
  let cwd = null;
  let access = null;
  const rest = [];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--help' || a === '-h') return { help: true };
    if (a === '--worker') { worker = true; continue; }
    if (a === '--all') { all = true; continue; }
    if (a === '--agent' || a === '-a') {
      agentName = argv[++i];
      if (!agentName) fail('--agent needs a name');
      continue;
    }
    if (a.startsWith('--agent=')) { agentName = a.slice(8); continue; }
    // @name before the verb, or right after a verb that takes no id
    // (`reset @name`). A later @word is part of the message.
    if (a.startsWith('@') && a.length > 1) {
      const afterVerb = rest.length === 1 && VERBS.has(rest[0]) && !['wait', 'resume', 'answer', 'asks'].includes(rest[0]);
      if (!agentName && (rest.length === 0 || afterVerb)) {
        const name = a.slice(1);
        if (!AGENT_RE.test(name)) fail(`bad agent name ${name} — letters, digits, - and _ only`);
        agentName = name;
        continue;
      }
    }
    if (a === '--follow' || a === '-f') { follow = true; continue; }
    if (a === '--model' || a === '-m') {
      model = argv[++i];
      if (!model) fail('--model needs a value');
      continue;
    }
    if (a.startsWith('--model=')) { model = a.slice(8); continue; }
    if (a === '--effort' || a === '-e') {
      effort = parseEffort(argv[++i], a);
      continue;
    }
    if (a.startsWith('--effort=')) {
      effort = parseEffort(a.slice(9), '--effort');
      continue;
    }
    if (a === '--cwd') {
      cwd = argv[++i];
      if (!cwd) fail('--cwd needs a directory');
      continue;
    }
    if (a.startsWith('--cwd=')) {
      cwd = a.slice(6);
      if (!cwd) fail('--cwd needs a directory');
      continue;
    }
    if (a === '--readonly' || a === '--read-only') {
      if (access === 'full') fail('pass --readonly or --read-write, not both');
      access = 'read-only';
      continue;
    }
    if (a === '--read-write') {
      if (access === 'read-only') fail('pass --readonly or --read-write, not both');
      access = 'full';
      continue;
    }
    // A brief is prose the shell must not touch: backticks in an argv string
    // are command substitution, so a brief that quotes shell would execute it.
    if (a === '--brief-file' || a === '--brief') {
      briefFile = argv[++i];
      if (!briefFile) fail(`${a} needs a path (or - for stdin)`);
      continue;
    }
    if (a.startsWith('--brief-file=')) { briefFile = a.slice(13); continue; }
    if (a.startsWith('--brief=')) { briefFile = a.slice(8); continue; }
    if (a === '-' && briefFile === null) { briefFile = '-'; continue; }
    if (a === '--timeout') {
      const v = argv[++i];
      timeoutSec = parseInt(v, 10);
      if (!Number.isFinite(timeoutSec) || timeoutSec <= 0) fail(`--timeout needs a positive number (got ${v})`);
      continue;
    }
    if (a.startsWith('--timeout=')) {
      timeoutSec = parseInt(a.slice(10), 10);
      if (!Number.isFinite(timeoutSec) || timeoutSec <= 0) fail(`--timeout needs a positive number`);
      continue;
    }
    if (a === '--interrupt' || a === '--clear-queue' || a === '--lead' || a === '-l' || a === '--backend' || a === '-b' || a === '--persona' || a === '--raw' || a === '--peer') {
      fail(`${a} is gone. Send interrupts if busy; queue with: coagent later "…"`);
    }
    if (a.startsWith('-') && a !== '-') fail(`unknown option ${a}`);
    rest.push(a);
  }
  if (agentName && !AGENT_RE.test(agentName)) {
    fail(`bad agent name ${agentName} — letters, digits, - and _ only`);
  }
  return { model, effort, follow, timeoutSec, worker, all, agentName, briefFile, cwd, access, rest };
}

// Briefs arrive as a file or on stdin so no shell ever parses them.
function readBrief(spec) {
  if (spec === '-') {
    if (process.stdin.isTTY) fail('no stdin to read a brief from — redirect a file, or use --brief-file');
    let raw;
    try { raw = fs.readFileSync(0, 'utf8'); } catch { fail('could not read a brief from stdin'); }
    if (!String(raw).trim()) fail('empty brief on stdin');
    return String(raw).trim();
  }
  if (!fs.existsSync(spec)) fail(`no brief file at ${spec}`);
  const raw = fs.readFileSync(spec, 'utf8');
  if (!raw.trim()) fail(`brief file ${spec} is empty`);
  return raw.trim();
}

function loadPersona(personaPath) {
  const p = personaPath || PERSONA_FILE;
  if (!fs.existsSync(p)) fail(`no persona at ${p}`);
  const raw = fs.readFileSync(p, 'utf8');
  const m = raw.match(/^---\n([\s\S]*?)\n---\n?([\s\S]*)$/);
  const meta = {};
  let body = raw;
  if (m) {
    body = m[2];
    for (const line of m[1].split('\n')) {
      const kv = line.match(/^([\w.-]+):\s*(.*)$/);
      if (kv) meta[kv[1]] = kv[2].trim();
    }
  }
  // `model.<agent>` / `effort.<agent>` are per-colleague policy; workerModel /
  // workerEffort are the fallback for every named colleague. @main is excluded
  // on purpose — it is the thinking partner and follows the lead.
  const byAgent = (prefix) => Object.entries(meta).reduce((acc, [k, v]) => {
    const m = k.match(new RegExp(`^${prefix}\\.(.+)$`));
    return m && v ? { ...acc, [m[1]]: v } : acc;
  }, {});
  return {
    path: p,
    effort: meta.effort || 'high',
    model: meta.model || null,
    workerModel: meta.workerModel || null,
    workerEffort: meta.workerEffort || null,
    agentModel: byAgent('model'),
    agentEffort: byAgent('effort'),
    permissionMode: meta.permissionMode || 'bypassPermissions',
    persona: body.trim(),
  };
}

// Each colleague owns a full copy of the standing-tape machinery — its own
// meta, inbox, lock and worker — so steering a busy one is the existing
// interrupt path, not a second execution model.
function agentKey(leadSessionId, name) {
  return path.join(leadSessionId, 'agents', name);
}

function agentsRoot(leadSessionId) {
  return path.join(STATE_DIR, leadSessionId, 'agents');
}

function listAgentNames(leadSessionId) {
  const root = agentsRoot(leadSessionId);
  if (!fs.existsSync(root)) return [];
  try {
    return fs.readdirSync(root, { withFileTypes: true })
      .filter((e) => e.isDirectory())
      .map((e) => e.name)
      .sort();
  } catch { return []; }
}

// Pre-agents state sat flat in state/<lead>/; move it under agents/main so a
// session that is mid-conversation keeps its tape.
function migrateFlatState(leadSessionId) {
  const flat = path.join(STATE_DIR, leadSessionId);
  const dest = path.join(flat, 'agents', DEFAULT_AGENT);
  if (!fs.existsSync(path.join(flat, 'meta.json')) || fs.existsSync(dest)) return;
  fs.mkdirSync(dest, { recursive: true });
  for (const f of ['meta.json', 'inbox.json', 'roster.json', 'worker.json', 'worker.lock', 'last_reply.md', 'last_reply.json']) {
    const from = path.join(flat, f);
    if (fs.existsSync(from)) {
      try { fs.renameSync(from, path.join(dest, f)); } catch { /* */ }
    }
  }
}

// A long job's only channel back before it finishes. Deliberately narrow: one
// append-only stream per lead session, so one watcher covers every worker.
function pingsPath(leadSessionId) {
  return path.join(STATE_DIR, leadSessionId, 'pings.jsonl');
}

// Beside the stream, not in meta.json: pings are per lead session while meta is
// per colleague, so a cursor in meta would be read once per agent.
function pingsCursorPath(leadSessionId) {
  return path.join(STATE_DIR, leadSessionId, 'pings.cursor');
}

function readPingCursor(leadSessionId, size) {
  const raw = parseInt(String(readFileOr(pingsCursorPath(leadSessionId), '0')).trim(), 10);
  const at = Number.isFinite(raw) && raw >= 0 ? raw : 0;
  return at > size ? 0 : at; // truncated or cleared out from under us
}

function writePingCursor(leadSessionId, at) {
  S.atomicWrite(pingsCursorPath(leadSessionId), `${at}\n`);
}

function readFileOr(p, fallback) {
  try { return fs.readFileSync(p, 'utf8'); } catch { return fallback; }
}

function asksDir(pingFile) {
  return path.join(path.dirname(pingFile), 'asks');
}

// A heartbeat, not a pidfile: the follower is usually a child of the lead's
// harness and can die without cleaning up, so freshness is what proves it is
// still delivering. Nothing reads a stale one as armed.
function followerPath(leadSessionId) {
  return path.join(STATE_DIR, leadSessionId, 'pings.follower');
}
const FOLLOWER_STALE_MS = 5000;

function beatFollower(leadSessionId) {
  try { S.atomicWrite(followerPath(leadSessionId), `${process.pid}\n`); } catch { /* */ }
}

function followerArmed(leadSessionId) {
  try {
    const st = fs.statSync(followerPath(leadSessionId));
    return Date.now() - st.mtimeMs < FOLLOWER_STALE_MS;
  } catch { return false; }
}

function appendPing(file, rec) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.appendFileSync(file, `${JSON.stringify({ at: new Date().toISOString(), ...rec })}\n`);
}

// A blocking question. Waits a bounded time for the lead to answer, then tells
// the worker to park — the tape survives, so the answer can arrive much later.
async function cmdAsk(cli, question) {
  const file = process.env.COAGENT_PING_FILE;
  if (!file) fail('ask is only available inside a co-agent worker');
  const body = String(question || '').trim();
  if (!body) fail('usage: coagent ask "…"');

  const from = process.env.COAGENT_PING_FROM || 'worker';
  const id = S.newId();
  const dir = asksDir(file);
  fs.mkdirSync(dir, { recursive: true });
  S.writeJson(path.join(dir, `${id}.json`), { id, from, question: body, at: new Date().toISOString() });
  appendPing(file, { from, kind: 'ask', id, text: body });

  const answerFile = path.join(dir, `${id}.answer`);
  const waitSec = cli.timeoutSec != null ? cli.timeoutSec : ASK_WAIT_SEC;
  const deadline = Date.now() + waitSec * 1000;
  while (Date.now() < deadline) {
    if (fs.existsSync(answerFile)) {
      console.log(fs.readFileSync(answerFile, 'utf8').trim());
      return;
    }
    await sleep(400);
  }
  // Parking is the designed fallback, not a failure — but it needs a distinct
  // status so a wrapper can branch on more than the message text.
  S.writeJson(path.join(dir, `${id}.json`), {
    id, from, question: body, at: new Date().toISOString(), expiredAt: new Date().toISOString(),
  });
  console.log(`NO ANSWER YET (${waitSec}s). Do not keep waiting and do not guess: `
    + `stop now and end your turn stating you are blocked on this question. `
    + `Your tape is kept — the lead will answer and resume you.`);
  process.exitCode = 3;
}

function cmdAnswer(id, text) {
  const ctx = resolveContext({}, { create: false });
  const dir = asksDir(pingsPath(ctx.lead.sessionId));
  const q = path.join(dir, `${id}.json`);
  if (!fs.existsSync(q)) fail(`unknown question ${id}  (try coagent asks)`);
  const body = String(text || '').trim();
  if (!body) fail('usage: coagent answer <id> "…"');
  S.atomicWrite(path.join(dir, `${id}.answer`), `${body}\n`);
  console.log(`co-agent: answered ${id}`);
}

function cmdAsks(cli, id) {
  const ctx = resolveContext(cli, { create: false });
  const dir = asksDir(pingsPath(ctx.lead.sessionId));
  if (!fs.existsSync(dir)) { console.log('no questions'); return; }
  const answerPath = (q) => path.join(dir, `${q.id}.answer`);
  const answered = (q) => fs.existsSync(answerPath(q));
  const all = fs.readdirSync(dir)
    .filter((f) => f.endsWith('.json'))
    .map((f) => S.readJson(path.join(dir, f), null))
    .filter(Boolean)
    .sort((a, b) => String(a.at || '').localeCompare(String(b.at || '')));
  // `asks <id>` shows one question answered or not, so a decision can be
  // audited after the fact; the bare list stays scoped to what is still open.
  const list = id ? all.filter((q) => q.id === id) : all.filter((q) => !answered(q));
  if (id && !list.length) fail(`unknown question ${id}`);
  if (!list.length) { console.log('no open questions'); return; }
  for (const q of list) {
    const state = answered(q) ? 'answered' : (q.expiredAt ? 'parked' : 'waiting');
    console.log(`${q.id}  @${q.from}  ${state}  ${ageLabel(q.at) || ''}`);
    // Never clipped. A question read at 160 chars gets answered on a guess,
    // and the guess looks exactly like an answer to the worker.
    for (const ln of String(q.question || '').split('\n')) console.log(`    ${ln}`);
    if (answered(q)) {
      for (const ln of readFileOr(answerPath(q), '').trim().split('\n')) console.log(`    > ${ln}`);
    } else {
      console.log(`    answer: coagent answer ${q.id} "…"`);
    }
    console.log('');
  }
}

// Runs INSIDE a worker, whose env is scrubbed of any lead identity — so the
// target is handed to it explicitly rather than resolved.
function cmdNotify(text) {
  const file = process.env.COAGENT_PING_FILE;
  if (!file) fail('notify is only available inside a co-agent worker');
  const body = String(text || '').trim();
  if (!body) fail('usage: coagent notify "…"');
  const line = JSON.stringify({
    at: new Date().toISOString(),
    from: process.env.COAGENT_PING_FROM || 'worker',
    text: body,
  });
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.appendFileSync(file, `${line}\n`);
  console.log('pinged');
}

function formatPing(line) {
  try {
    const p = JSON.parse(line);
    return `@${p.from}  ${p.text}`;
  } catch { return null; }
}

// --follow is the delivery path: the lead arms it once per session under a
// per-line watcher, so a worker's ping surfaces while it is still working.
// Without it, notify only reaches the lead on the next manual pull.
// Not eventsSince: that skips a leading partial line to resume mid-transcript,
// but a ping cursor always sits on a newline boundary, so it would eat the
// first complete ping on every read. Only whole lines count here.
function readPingsSince(file, offset) {
  const size = fs.statSync(file).size;
  if (offset >= size) return { pings: [], next: offset };
  const fd = fs.openSync(file, 'r');
  let chunk;
  try {
    const buf = Buffer.alloc(size - offset);
    fs.readSync(fd, buf, 0, buf.length, offset);
    chunk = buf.toString('utf8');
  } finally {
    fs.closeSync(fd);
  }
  const lastBreak = chunk.lastIndexOf('\n');
  if (lastBreak < 0) return { pings: [], next: offset }; // a half-written line
  const complete = chunk.slice(0, lastBreak);
  const pings = [];
  for (const line of complete.split('\n')) {
    if (!line) continue;
    try { pings.push(JSON.parse(line)); } catch { /* */ }
  }
  return { pings, next: offset + Buffer.byteLength(complete, 'utf8') + 1 };
}

const renderPing = (rec) => {
  if (!rec || !rec.text) return null;
  const tag = rec.kind === 'ask' ? `ASK ${rec.id} ` : '';
  const age = ageLabel(rec.at);
  return `${age ? `${age}  ` : ''}@${rec.from || 'worker'}  ${tag}${rec.text}`;
};

async function cmdPings(cli) {
  // Inside a worker there is no lead to resolve — it would resolve itself.
  // Workers get the whole shared log and leave the lead's cursor alone.
  const workerFile = process.env.COAGENT_PING_FILE;
  if (workerFile) {
    if (!fs.existsSync(workerFile)) { console.log('no pings'); return; }
    const me = process.env.COAGENT_PING_FROM || 'worker';
    const { pings } = readPingsSince(workerFile, 0);
    const others = pings.filter((x) => x.from !== me);
    if (!others.length) { console.log('no pings from other workers'); return; }
    for (const x of others) {
      const out = renderPing(x);
      if (out) console.log(out);
    }
    return;
  }

  const ctx = resolveContext(cli, { create: false });
  const lead = ctx.lead.sessionId;
  const file = pingsPath(lead);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  if (!fs.existsSync(file)) fs.writeFileSync(file, '');

  const size = fs.statSync(file).size;
  // --all rereads the whole log but still leaves the cursor at the end, so the
  // next plain read is clean.
  let offset = cli.all ? 0 : readPingCursor(lead, size);

  const flush = () => {
    const cur = fs.existsSync(file) ? fs.statSync(file).size : 0;
    if (cur < offset) offset = 0;
    if (cur <= offset) return 0;
    const { pings, next } = readPingsSince(file, offset);
    for (const p of pings) {
      const out = renderPing(p);
      if (out) console.log(out);
    }
    offset = next;
    writePingCursor(lead, offset);
    return pings.length;
  };

  if (!cli.follow) {
    const shown = flush();
    if (!shown) {
      const total = fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).length;
      console.log(total ? `no new pings (${total} earlier — coagent pings --all)` : 'no pings');
    }
    return;
  }

  // Start from the cursor, not EOF: a ping that landed between dispatching a
  // worker and arming this watcher would otherwise be lost.
  flush();
  beatFollower(lead);
  try {
    for (;;) {
      flush();
      beatFollower(lead);
      await sleep(400);
    }
  } finally {
    try { fs.rmSync(followerPath(lead), { force: true }); } catch { /* */ }
  }
}

let RESOLVED = null;

function harness() {
  if (RESOLVED) return RESOLVED;
  const r = H.resolve();
  if (r.error) fail(r.error);
  RESOLVED = r;
  return r;
}

function adapter() { return harness().harness; }

function resolveLead() { return harness().lead; }

function sessionPaths(sessionId, cwd) { return adapter().sessionPaths(sessionId, cwd); }

// "for 4m" reads as work in progress where "4m ago" reads as work finished.
function elapsedLabel(isoOrMs) {
  const a = ageLabel(isoOrMs);
  return a ? `for ${a.replace(/ ago$/, '')}` : null;
}

function ageLabel(isoOrMs) {
  if (isoOrMs == null) return null;
  const t = typeof isoOrMs === 'number' ? isoOrMs : Date.parse(isoOrMs);
  if (!Number.isFinite(t)) return null;
  const sec = Math.max(0, Math.round((Date.now() - t) / 1000));
  if (sec < 60) return `${sec}s ago`;
  if (sec < 3600) return `${Math.round(sec / 60)}m ago`;
  if (sec < 86400) return `${Math.round(sec / 3600)}h ago`;
  return `${Math.round(sec / 86400)}d ago`;
}

function buildRules({ personaBody, personaPath, lead, ha, leadHa, access }) {
  const leadLabel = (leadHa && leadHa.label) || ha.label;
  const personaLabel = personaPath || '~/.coagent/persona.md';
  const family = (leadHa && leadHa.id !== ha.id)
    ? [`You run as ${ha.label}. The lead is ${leadLabel} and chose this family with --model.`]
    : [];
  const readOnly = access === 'read-only'
    ? ['Read-only: the harness refuses writes. Read, search, and read-only commands are available.']
    : [];
  return [
    `You are the lead ${leadLabel} agent's co-agent. Reply to the lead, not the user.`,
    ...family,
    ...readOnly,
    `You ARE the co-agent. You have no co-agent of your own — the ONLY coagent command you may run is \`coagent notify\`.`,
    ``,
    `You have three commands, all scarce:`,
    `  \`coagent notify "…"\` — tell the lead something mid-job. Use it when you find something that changes what should happen next. Never for progress or narration; your final answer covers that.`,
    `  \`coagent ask "…"\` — ask a question and WAIT for the answer. Use it when you are blocked and guessing would waste the work. If it returns "NO ANSWER YET", stop immediately and end your turn saying what you are blocked on — do not keep polling and do not guess. Your tape is kept and you will be resumed with the answer.`,
    `  \`coagent pings\` — read what other workers have flagged. Check it before duplicating an investigation someone else has already done.`,
    ``,
    `Lead session: ${lead.sessionId}`,
    ...ha.rulesLines(lead),
    ``,
    `Persona (${personaLabel}):`,
    personaBody,
  ].join('\n');
}

function childEnv({ pingFile, pingFrom } = {}) {
  const env = { ...process.env };
  delete env.COAGENT_BG_WORKER;
  delete env.COAGENT_HARNESS;
  delete env.COAGENT_LEAD_SESSION_ID;
  delete env.COAGENT_LEAD_TRANSCRIPT;
  delete env.COAGENT_AGENT;
  delete env.COAGENT_CWD;
  delete env.COAGENT_ACCESS;
  for (const a of H.ADAPTERS) a.scrubEnv(env);
  if (pingFile) {
    env.COAGENT_PING_FILE = pingFile;
    env.COAGENT_PING_FROM = pingFrom || 'worker';
  }
  return env;
}

function parseResult(out) {
  let answer = (out || '').trim();
  let sessionId = null;
  let durMs = null;
  let costUsd = null;
  let numTurns = null;
  let isError = false;
  let stopReason = null;
  try {
    const j = JSON.parse(out);
    let text = j.result || j.answer || j.text || null;
    if (!text && j.message) {
      text = typeof j.message === 'string' ? j.message
        : (j.message.content || j.message.text || null);
    }
    if (text != null) answer = typeof text === 'string' ? text : JSON.stringify(text);
    sessionId = j.sessionId || j.session_id || null;
    isError = !!j.isError || !!j.is_error;
    durMs = j.durationMs || j.duration_ms || null;
    costUsd = j.totalCostUsd != null ? j.totalCostUsd : (j.total_cost_usd != null ? j.total_cost_usd : null);
    numTurns = j.numTurns != null ? j.numTurns : (j.num_turns != null ? j.num_turns : null);
    stopReason = j.stopReason || j.stop_reason || null;
  } catch { /* plain text */ }
  return { answer, sessionId, durMs, costUsd, numTurns, isError, stopReason };
}

function resolveContext(cli, { create = true } = {}) {
  const persona = loadPersona(PERSONA_FILE);
  const leadHa = adapter();
  const lead = resolveLead();
  migrateFlatState(lead.sessionId);
  const agentName = cli.agentName || process.env.COAGENT_AGENT || DEFAULT_AGENT;
  const key = agentKey(lead.sessionId, agentName);
  if (create) {
    const known = listAgentNames(lead.sessionId);
    if (!known.includes(agentName) && known.length >= MAX_AGENTS) {
      fail(`already running ${known.length} colleagues (${known.join(', ')}) — max ${MAX_AGENTS}. Reset or reuse one.`);
    }
    S.ensureLead(STATE_DIR, key);
  }
  const meta = S.loadMeta(STATE_DIR, key);
  const leadModel = leadHa.describeSession({
    dir: lead.sessionDir,
    transcript: lead.transcriptPath,
  });
  const asked = cli.model || process.env.COAGENT_MODEL || null;
  if (asked && !H.adapterForModel(asked)) {
    fail(`unknown model ${asked} — use a grok, claude, opus, sonnet, haiku, or fable id`);
  }
  const askedEffortRaw = cli.effort || process.env.COAGENT_EFFORT || null;
  const askedEffort = askedEffortRaw ? parseEffort(askedEffortRaw, '--effort') : null;
  // Named colleagues are fan-out: a diff-and-grep worker inheriting the lead's
  // top model at high effort is pure cost. Policy beats inheritance for them,
  // and only for them — @main still follows the lead unless --model / --effort
  // is set.
  const isColleague = agentName !== DEFAULT_AGENT;
  const policyModel = isColleague
    ? (persona.agentModel[agentName] || process.env.COAGENT_WORKER_MODEL || persona.workerModel || null)
    : null;
  if (policyModel && !H.adapterForModel(policyModel)) {
    fail(`unknown worker model ${policyModel} — use a grok, claude, opus, sonnet, haiku, or fable id`);
  }
  const policyEffort = isColleague
    ? (persona.agentEffort[agentName] || process.env.COAGENT_WORKER_EFFORT || persona.workerEffort || null)
    : null;
  const inferred = leadHa.acceptsModel(leadModel.modelId) ? leadModel.modelId : null;
  const model = asked || policyModel || inferred || persona.model || null;
  const ha = (asked && H.adapterForModel(asked))
    || (policyModel && !asked && H.adapterForModel(policyModel))
    || (meta.harness && H.byId(meta.harness))
    || (model && H.adapterForModel(model))
    || leadHa;
  const effort = resolveEffort({
    asked: askedEffort,
    policy: policyEffort,
    lead: leadModel.effort,
    persona: persona.effort,
  });
  // The lead's checkout is the default only. An explicit --cwd, then this
  // colleague's stored directory, win over it. The worker is a new process
  // and only sees what workerEnv put in COAGENT_CWD.
  const leadCwd = leadModel.cwd || process.cwd();
  const cwd = resolveWorkdir(cli.cwd || process.env.COAGENT_CWD || meta.cwd || leadCwd);
  const access = resolveAccess({
    asked: cli.access,
    env: process.env.COAGENT_ACCESS,
    stored: meta.access,
  });
  // Grok's `grok-build-plan` is not a Claude agent. Only forward --agent
  // when the inner family is the lead's.
  const agent = (ha.id === leadHa.id ? leadModel.agent : null) || null;
  return {
    persona,
    ha,
    leadHa,
    lead,
    agentName,
    key,
    meta,
    leadModel,
    model,
    effort,
    leadCwd,
    cwd,
    access,
    agent,
    permissionMode: persona.permissionMode,
  };
}

function writeReplyFiles(key, { answer, meta, message, sessionId, itemId }) {
  const body = `${answer || ''}${meta ? `\n\n↳ ${meta}` : ''}\n`;
  S.atomicWrite(S.lastReplyPath(STATE_DIR, key), body);
  S.writeJson(S.lastReplyMetaPath(STATE_DIR, key), {
    answer: answer || '',
    meta: meta || null,
    message: message || null,
    sessionId: sessionId || null,
    itemId: itemId || null,
    at: new Date().toISOString(),
  });
}

function eventsSince(filePath, sinceByte, format) {
  if (!filePath || !fs.existsSync(filePath)) return { lines: [], size: 0 };
  const st = fs.statSync(filePath);
  const size = st.size;
  if (sinceByte >= size) return { lines: [], size };
  const fd = fs.openSync(filePath, 'r');
  try {
    const len = size - sinceByte;
    const buf = Buffer.alloc(len);
    fs.readSync(fd, buf, 0, len, sinceByte);
    let chunk = buf.toString('utf8');
    if (sinceByte > 0 && !chunk.startsWith('\n') && chunk.includes('\n')) {
      chunk = chunk.slice(chunk.indexOf('\n') + 1);
    }
    const lines = [];
    for (const line of chunk.split('\n').filter(Boolean)) {
      let rec;
      try { rec = JSON.parse(line); } catch { continue; }
      const formatted = format(rec);
      if (formatted) lines.push(formatted);
    }
    return { lines, size };
  } finally {
    fs.closeSync(fd);
  }
}

function runCmd(cmd, args, { onSpawn, cwd, sessionId, ha, ping }) {
  return new Promise((resolve) => {
    const child = spawn(cmd, args, {
      cwd: cwd || process.cwd(),
      env: childEnv(ping),
      stdio: ['ignore', 'pipe', 'pipe'],
    });
    if (onSpawn) onSpawn(child.pid);
    let out = '';
    let err = '';
    let offset = 0;
    const existing = sessionId && ha.sessionPaths(sessionId, cwd).transcript;
    if (existing && fs.existsSync(existing)) offset = fs.statSync(existing).size;
    const pump = () => {
      if (!sessionId) return;
      const tpath = ha.sessionPaths(sessionId, cwd).transcript;
      if (!tpath || !fs.existsSync(tpath)) return;
      const { lines, size } = eventsSince(tpath, offset, (rec) => ha.formatUpdate(rec, HOME));
      for (const ln of lines) console.error(ln);
      offset = size;
    };
    const timer = setInterval(pump, 400);
    child.stdout.on('data', (d) => { out += d; });
    child.stderr.on('data', (d) => { err += d; });
    child.on('close', (code) => {
      clearInterval(timer);
      pump();
      resolve({ code, out, err });
    });
  });
}

async function reap(key) {
  const { orphanPid } = S.reapStale(STATE_DIR, key);
  if (orphanPid) await killTree(orphanPid);
}

async function killCurrentChild(key, itemId, { wait = true } = {}) {
  const deadline = Date.now() + (wait ? 3000 : 0);
  for (;;) {
    const w = S.readWorker(STATE_DIR, key);
    const mine = w && (!itemId || w.itemId === itemId);
    if (mine && w.childPid && S.tokenAlive(w.childToken || w.childPid)) {
      await killTree(w.childPid);
      return true;
    }
    const item = itemId ? S.findItem(STATE_DIR, key, itemId) : null;
    if (item && !S.isLive(item) && item.status !== 'interrupted') return false;
    if (Date.now() >= deadline) return false;
    await sleep(100);
  }
}

async function runTurn(ctx, item) {
  const { persona, ha, leadHa, lead, model, effort, agent, permissionMode, key } = ctx;
  // The queued item wins over the worker's start-up context, so a steer can
  // change directory or access without waiting for the old worker to exit.
  const turnCwd = item.cwd || ctx.cwd;
  const turnAccess = item.access || ctx.access;
  let meta = S.loadMeta(STATE_DIR, key);
  const rules = buildRules({
    personaBody: persona.persona,
    personaPath: persona.path,
    lead,
    ha,
    leadHa,
    access: turnAccess,
  });
  const decision = resumeDecision({ meta, harnessId: ha.id, cwd: turnCwd, access: turnAccess });
  if (meta.sessionId && !decision.resume && decision.reason) {
    console.error(`coagent: @${ctx.agentName} ${decision.reason}; new tape`);
  }
  const existing = decision.resume;

  const argsFor = ({ sid, resume, prompt }) => ha.buildArgs({
    prompt,
    effort,
    model,
    permissionMode,
    rules,
    sessionId: sid,
    resume,
    agent,
    cwd: turnCwd,
    access: turnAccess,
  });

  const mkNew = (prompt) => {
    const sid = crypto.randomUUID();
    return { sid, args: argsFor({ sid, resume: false, prompt }) };
  };

  const prompt = item.message;
  let run = existing
    ? { sid: meta.sessionId, args: argsFor({ sid: meta.sessionId, resume: true, prompt }) }
    : mkNew(prompt);

  const stamp = (sid) => (childPid) => {
    S.writeWorker(STATE_DIR, key, {
      pid: process.pid,
      childPid,
      childToken: S.pidToken(childPid),
      itemId: item.id,
      sessionId: sid,
    });
    const now = S.findItem(STATE_DIR, key, item.id);
    if (now && now.status === 'interrupted') killTree(childPid).catch(() => { /* */ });
  };

  const abandoned = () => {
    const now = S.findItem(STATE_DIR, key, item.id);
    return !!now && !S.isLive(now);
  };

  const bin = H.resolveBin(ha);
  const ping = { pingFile: pingsPath(lead.sessionId), pingFrom: ctx.agentName };
  let res = await runCmd(bin, run.args, { onSpawn: stamp(run.sid), cwd: turnCwd, sessionId: run.sid, ha, ping });
  if (abandoned()) return { interrupted: true };

  let forkedFrom = null;
  if (res.code !== 0 && existing) {
    const fresh = mkNew(prompt);
    console.error(`coagent: resume of ${meta.sessionId} failed (exit ${res.code}); starting a new tape ${fresh.sid}`);
    const retry = await runCmd(bin, fresh.args, { onSpawn: stamp(fresh.sid), cwd: turnCwd, sessionId: fresh.sid, ha, ping });
    if (abandoned()) return { interrupted: true };
    if (retry.code === 0) {
      run = fresh;
      res = retry;
      forkedFrom = meta.sessionId;
    }
  }

  if (res.code !== 0) {
    const err = (res.err || res.out || '').trim().slice(0, 800);
    return { failed: true, error: err, code: res.code };
  }

  const parsed = parseResult(res.out);
  if (parsed.sessionId) run.sid = parsed.sessionId;

  const dur = parsed.durMs != null ? `${(parsed.durMs / 1000).toFixed(1)}s` : null;
  const cost = parsed.costUsd != null ? `$${Number(parsed.costUsd).toFixed(4)}` : null;
  const turns = parsed.numTurns != null ? `${parsed.numTurns} turns` : null;
  const inner = ha.sessionPaths(run.sid, turnCwd);
  const bits = [
    `lead=${lead.sessionId}`,
    `model=${model || ha.id}`,
    `item=${item.id}`,
    parsed.isError && '⚠ error',
    parsed.stopReason,
    dur,
    turns,
    cost,
    forkedFrom && `NEW TAPE (forked from ${forkedFrom})`,
    inner.transcript && `transcript: ${inner.transcript}`,
  ].filter(Boolean).join(' · ');

  writeReplyFiles(key, {
    answer: parsed.answer,
    meta: bits,
    message: item.message,
    sessionId: run.sid,
    itemId: item.id,
  });

  S.addToRoster(STATE_DIR, key, {
    id: run.sid,
    createdAt: new Date().toISOString(),
    cwd: turnCwd,
    model,
    harness: ha.id,
  });
  const prevMeta = S.loadMeta(STATE_DIR, key);
  S.saveMeta(STATE_DIR, key, {
    ...prevMeta,
    sessionId: run.sid,
    harness: ha.id,
    cwd: turnCwd,
    access: turnAccess,
    model: model || null,
    effort: effort || null,
    agent: agent || null,
    lastQuestion: item.message,
    lastQuestionAt: new Date().toISOString(),
    lastError: null,
    lastMeta: bits,
    lastDurMs: parsed.durMs != null ? parsed.durMs : null,
    lastCostUsd: parsed.costUsd != null ? parsed.costUsd : null,
    lastNumTurns: parsed.numTurns != null ? parsed.numTurns : null,
    // Running totals: the per-turn figure answers "what did that cost", the
    // total answers "what has this colleague cost me", which is the one that
    // actually changes how you brief the next one.
    totalCostUsd: Number(prevMeta.totalCostUsd || 0) + Number(parsed.costUsd || 0),
    totalTurns: Number(prevMeta.totalTurns || 0) + Number(parsed.numTurns || 0),
    personaPath: persona.path,
  });

  return { answer: parsed.answer, meta: bits, sessionId: run.sid };
}

async function processQueue(ctx) {
  const key = ctx.key;
  await reap(key);
  for (;;) {
    const next = S.nextQueued(STATE_DIR, key);
    if (!next) return;
    S.updateItem(STATE_DIR, key, next.id, {
      status: 'running',
      startedAt: new Date().toISOString(),
    });
    S.writeWorker(STATE_DIR, key, {
      pid: process.pid,
      childPid: null,
      itemId: next.id,
    });
    const result = await runTurn(ctx, next);
    const now = S.findItem(STATE_DIR, key, next.id);
    if (now && now.status === 'interrupted') continue;
    if (result.interrupted) continue;
    if (result.failed) {
      S.updateItem(STATE_DIR, key, next.id, {
        status: 'failed',
        finishedAt: new Date().toISOString(),
        error: result.error,
      });
      S.saveMeta(STATE_DIR, key, {
        ...S.loadMeta(STATE_DIR, key),
        lastError: result.error,
      });
      const leftover = S.loadInbox(STATE_DIR, key).filter((i) => i.status === 'queued').length;
      if (leftover) console.error(`coagent: item ${next.id} failed; continuing queue (${leftover} remaining)`);
      continue;
    }
    S.updateItem(STATE_DIR, key, next.id, {
      status: 'done',
      finishedAt: new Date().toISOString(),
      error: null,
      answer: result.answer || null,
      meta: result.meta || null,
    });
  }
}

async function becomeWorkerAndDrain(ctx) {
  const key = ctx.key;
  if (!S.tryLock(STATE_DIR, key, process.pid)) return false;
  S.writeWorker(STATE_DIR, key, { pid: process.pid, childPid: null, itemId: null });
  try {
    await processQueue(ctx);
  } finally {
    S.releaseLock(STATE_DIR, key, process.pid);
    const w = S.readWorker(STATE_DIR, key);
    if (w && w.pid === process.pid) {
      S.writeWorker(STATE_DIR, key, { pid: null, childPid: null, itemId: null });
    }
  }
  return true;
}

function workerEnv(ctx) {
  const env = { ...process.env };
  env.COAGENT_BG_WORKER = '1';
  env.COAGENT_LEAD_SESSION_ID = ctx.lead.sessionId;
  // Lead family for detect(); inner model/effort come from COAGENT_MODEL / COAGENT_EFFORT.
  env.COAGENT_HARNESS = (ctx.leadHa || ctx.ha).id;
  env.COAGENT_AGENT = ctx.agentName;
  if (ctx.model) env.COAGENT_MODEL = ctx.model;
  if (ctx.effort) env.COAGENT_EFFORT = ctx.effort;
  if (ctx.cwd) env.COAGENT_CWD = ctx.cwd;
  if (ctx.access) env.COAGENT_ACCESS = ctx.access;
  if (ctx.lead.transcriptPath) env.COAGENT_LEAD_TRANSCRIPT = ctx.lead.transcriptPath;
  env.COAGENT_HOME = ROOT;
  return env;
}

function spawnDetachedWorker(ctx) {
  const child = spawn(process.execPath, [__filename, '--worker'], {
    detached: true,
    stdio: 'ignore',
    cwd: ctx.cwd || process.cwd(),
    env: workerEnv(ctx),
  });
  child.unref();
}

async function ensureWorker(ctx) {
  const key = ctx.key;
  await reap(key);
  if (S.workerAlive(STATE_DIR, key)) return;
  spawnDetachedWorker(ctx);
  const deadline = Date.now() + 2000;
  while (Date.now() < deadline) {
    if (S.workerAlive(STATE_DIR, key)) return;
    await sleep(50);
  }
  console.error('coagent: warning: worker not yet running — try coagent');
}

function clip(s, n) { return R.clip(s, n, HOME); }

async function cmdSend(message, cli, { later = false } = {}) {
  if (!String(message || '').trim()) fail('usage: coagent "…"  or  coagent later "…"');
  const ctx = resolveContext(cli);
  const key = ctx.key;
  await reap(key);

  const running = S.runningItem(STATE_DIR, key);
  let interrupted = null;
  if (running && !later) {
    interrupted = S.interruptRunning(STATE_DIR, key);
    const item = S.enqueue(STATE_DIR, key, message, { front: true, cwd: ctx.cwd, access: ctx.access });
    await killCurrentChild(key, running.id);
    await ensureWorker(ctx);
    console.log(`co-agent: send-now  ${item.id}  (interrupted ${running.id})`);
    printSendFooter(ctx, item);
    return;
  }

  const item = S.enqueue(STATE_DIR, key, message, { front: false, cwd: ctx.cwd, access: ctx.access });
  await ensureWorker(ctx);
  const kind = running && later ? 'queued' : 'sent';
  const note = running && later ? `(behind ${running.id})` : '(starting)';
  console.log(`co-agent: ${kind}  ${item.id}  ${note}`);
  printSendFooter(ctx, item);
  void interrupted;
}

function printSendFooter(ctx, item) {
  // ctx.key, not the lead id: a named colleague has its own meta and its own
  // inbox, so the lead's key reports the wrong session and the printed `wait`
  // looks the item up in @main, where it does not exist.
  const meta = S.loadMeta(STATE_DIR, ctx.key);
  const at = ctx.agentName === DEFAULT_AGENT ? '' : `@${ctx.agentName} `;
  if (meta.sessionId) console.log(`  inner: ${meta.sessionId}`);
  if (ctx.cwd && ctx.cwd !== ctx.leadCwd) console.log(`  cwd: ${ctx.cwd}`);
  if (ctx.access === 'read-only') console.log('  access: read-only');
  console.log(`  wait: coagent ${at}wait ${item.id}    watch: coagent ${at}watch`);
}

function consultAge(item) {
  return ageLabel(item && (item.finishedAt || item.startedAt || item.createdAt));
}

function printConsult(item, { full = false } = {}) {
  console.log(R.formatConsult(item, {
    home: HOME,
    age: consultAge(item),
    answerMax: full ? null : 240,
  }));
}

function innerTape(ctx) {
  const meta = S.loadMeta(STATE_DIR, ctx.key);
  const worker = S.readWorker(STATE_DIR, ctx.key);
  const running = S.runningItem(STATE_DIR, ctx.key);
  const sessionId = (worker && worker.sessionId) || meta.sessionId || null;
  const cwd = (running && running.cwd) || meta.cwd || ctx.cwd;
  return { meta, worker, running, sessionId, cwd, paths: ctx.ha.sessionPaths(sessionId, cwd) };
}

function makeUpdatePump(ctx) {
  // Follow the session the worker is driving. meta.sessionId is only written
  // when the turn finishes, so a wait that starts at "sent" would otherwise
  // stay silent, and it would look in the lead's directory.
  const initial = innerTape(ctx).paths.transcript;
  let seenPath = initial && fs.existsSync(initial) ? initial : null;
  let offset = seenPath ? fs.statSync(seenPath).size : 0;
  let announced = false;
  return function pump() {
    const tape = innerTape(ctx);
    const childUp = tape.worker && tape.worker.childPid
      && S.tokenAlive(tape.worker.childToken || tape.worker.childPid);
    if (!announced && childUp) {
      announced = true;
      const cost = typeof ctx.ha.runningCost === 'function' ? ctx.ha.runningCost(tape.paths) : null;
      console.error(`co-agent: @${ctx.agentName} reading${cost != null ? `  $${cost.toFixed(3)}` : ''}`);
    }
    const p = tape.paths.transcript;
    if (!p || !fs.existsSync(p)) return;
    if (p !== seenPath) {
      offset = 0;
      seenPath = p;
    }
    const { lines, size } = eventsSince(p, offset, (rec) => ctx.ha.formatUpdate(rec, HOME));
    for (const ln of lines) console.error(ln);
    offset = size;
  };
}

async function cmdStop(cli) {
  const ctx = resolveContext(cli);
  const key = ctx.key;
  await reap(key);
  const running = S.runningItem(STATE_DIR, key);
  if (!running && !S.workerAlive(STATE_DIR, key)) {
    console.log('co-agent: already idle');
    return;
  }
  const stopped = S.interruptRunning(STATE_DIR, key);
  await killCurrentChild(key, running && running.id);
  const queued = S.loadInbox(STATE_DIR, key).filter((i) => i.status === 'queued').length;
  console.log(`co-agent: stopped${stopped[0] ? ` ${stopped[0].id}` : ''}${queued ? `  (${queued} still queued)` : ''}`);
}

function itemSettled(it) {
  return it && (it.status === 'done' || it.status === 'failed' || it.status === 'interrupted');
}

async function cmdWait(cli, itemId) {
  const ctx = resolveContext(cli, { create: false });
  const key = ctx.key;
  const timeoutSec = cli.timeoutSec != null ? cli.timeoutSec : DEFAULT_WAIT_SEC;
  const deadline = Date.now() + timeoutSec * 1000;
  await reap(key);

  if (itemId) {
    const target = S.findItem(STATE_DIR, key, itemId);
    if (!target) fail(`unknown item ${itemId}`);
  }

  const trackedIds = itemId
    ? [itemId]
    : S.liveItems(STATE_DIR, key).map((i) => i.id);

  const done = () => {
    if (itemId) {
      const it = S.findItem(STATE_DIR, key, itemId);
      return itemSettled(it);
    }
    return !S.busy(STATE_DIR, key);
  };

  if (!done()) {
    const pump = makeUpdatePump(ctx);
    while (Date.now() < deadline) {
      await reap(key);
      pump();
      if (done()) break;
      await sleep(250);
    }
    pump();
  }

  if (!done()) fail(`timed out after ${timeoutSec}s waiting${itemId ? ` for ${itemId}` : ' for idle'}`);

  let toPrint;
  if (itemId) {
    toPrint = [S.findItem(STATE_DIR, key, itemId)].filter(Boolean);
  } else if (trackedIds.length) {
    const byId = new Map(S.loadInbox(STATE_DIR, key).map((i) => [i.id, i]));
    toPrint = trackedIds.map((id) => byId.get(id)).filter(itemSettled);
    const extra = S.loadInbox(STATE_DIR, key).filter((i) => (
      itemSettled(i) && !trackedIds.includes(i.id) && i.finishedAt
      && Date.parse(i.finishedAt) >= deadline - timeoutSec * 1000
    ));
    for (const it of extra) {
      if (!toPrint.some((x) => x.id === it.id)) toPrint.push(it);
    }
  } else {
    const last = S.sortInboxNewestFirst(S.loadInbox(STATE_DIR, key)).find(itemSettled);
    toPrint = last ? [last] : [];
  }

  if (!toPrint.length) {
    console.log('co-agent: idle');
    return;
  }
  for (const it of toPrint) printConsult(it, { full: true });
  const failed = toPrint.find((i) => i.status === 'failed');
  if (failed) fail(`turn failed: ${failed.error || failed.id}`);
}

function cmdStatus(cli) {
  const ctx = resolveContext(cli, { create: false });
  const key = ctx.key;
  S.reapStale(STATE_DIR, key);
  const meta = S.loadMeta(STATE_DIR, key);
  const inbox = S.loadInbox(STATE_DIR, key);
  const live = inbox.filter(S.isLive);
  const w = S.readWorker(STATE_DIR, key);
  const workerOn = S.workerAlive(STATE_DIR, key);
  const tape = innerTape(ctx);
  const inner = tape.paths;
  const innerInfo = ctx.ha.describeSession(inner);

  const family = ctx.leadHa && ctx.leadHa.id !== ctx.ha.id
    ? `  inner=${ctx.ha.id}`
    : '';
  console.log(`co-agent: @${ctx.agentName}  lead=${ctx.lead.sessionId}  harness=${(ctx.leadHa || ctx.ha).id}${family}  pin=${ctx.lead.pin || '?'}`);
  console.log(`  inner: ${meta.sessionId || '(none — send a message to start one)'}${innerInfo.title ? `  "${innerInfo.title}"` : ''}`);
  console.log(`  model: ${ctx.model || '(default)'}  effort=${ctx.effort || '?'}${ctx.access === 'read-only' ? '  read-only' : ''}`);
  console.log(`  cwd: ${ctx.cwd}`);
  console.log(`  worker: ${workerOn ? `pid=${w && w.pid}` : 'idle'}${w && w.childPid ? ` child=${w.childPid}` : ''}`);
  if (live.length) {
    console.log('  queue:');
    for (const i of live) console.log(`    ${i.id}  ${i.status}  ${clip(i.message, 80)}`);
  } else {
    console.log('  queue: empty');
  }
  const recent = S.sortInboxNewestFirst(inbox).filter(itemSettled).slice(0, 5);
  if (recent.length) {
    console.log('  recent:');
    for (const i of recent) {
      for (const ln of R.formatConsult(i, { home: HOME, age: consultAge(i), answerMax: 160 }).split('\n')) {
        console.log(`    ${ln}`);
      }
    }
  }
  if (meta.lastError) console.log(`  last error: ${clip(meta.lastError, 200)}`);
  console.log(`  lead transcript: ${ctx.lead.transcriptPath || '(none)'}`);
  if (ctx.lead.contextPath) console.log(`  lead context: ${ctx.lead.contextPath}`);
  if (inner.transcript) console.log(`  inner transcript: ${inner.transcript}`);
}

function agentSummary(leadSessionId, name) {
  const key = agentKey(leadSessionId, name);
  S.reapStale(STATE_DIR, key);
  const meta = S.loadMeta(STATE_DIR, key);
  const inbox = S.loadInbox(STATE_DIR, key);
  const live = inbox.filter(S.isLive);
  const worker = S.readWorker(STATE_DIR, key);
  const running = live.find((i) => i.status === 'running');
  const state = running
    ? ((worker && worker.childPid) ? 'reading' : 'starting')
    : (live.length ? `${live.length} queued` : 'idle');
  const last = S.sortInboxNewestFirst(inbox).find(itemSettled);
  return { name, key, meta, live, running, state, last, worker };
}

function cmdAgents(cli) {
  const ctx = resolveContext(cli, { create: false });
  const names = listAgentNames(ctx.lead.sessionId);
  if (!names.length) {
    console.log('no colleagues yet — send a message to start one');
    return;
  }
  let inFlight = 0;
  let fleetCost = 0;
  for (const name of names) {
    const a = agentSummary(ctx.lead.sessionId, name);
    if (a.running || a.live.length) inFlight += 1;
    const ha = H.byId(a.meta.harness) || ctx.ha;
    const sid = (a.worker && a.worker.sessionId) || a.meta.sessionId;
    const costCwd = (a.running && a.running.cwd) || a.meta.cwd;
    const liveCost = sid && typeof ha.runningCost === 'function'
      ? ha.runningCost(ha.sessionPaths(sid, costCwd))
      : null;
    const dollars = liveCost != null ? liveCost : (a.meta.totalCostUsd ? Number(a.meta.totalCostUsd) : null);
    if (dollars) fleetCost += dollars;
    const mark = name === ctx.agentName ? '*' : ' ';
    const spend = dollars ? `$${dollars.toFixed(3)}` : null;
    const facts = [
      a.state,
      a.meta.harness && ctx.leadHa && a.meta.harness !== ctx.leadHa.id ? a.meta.harness : null,
      a.meta.model,
      a.meta.access === 'read-only' ? 'read-only' : null,
      a.meta.effort && a.meta.effort !== 'high' ? a.meta.effort : null,
      a.running ? elapsedLabel(a.running.startedAt) : null,
      spend,
    ].filter(Boolean).join('  ');
    console.log(`${mark} @${name}  ${facts}`);
    const showing = a.running || a.live[0] || a.last;
    if (showing) console.log(`    ${clip(showing.message, 90)}`);
  }
  if (fleetCost) console.log(`  total: $${fleetCost.toFixed(3)}`);
  // Claude Code has no wake-on-child-done, so a silent ask looks hung.
  if (
    inFlight
    && ctx.leadHa
    && ctx.leadHa.id === 'claude'
    && !followerArmed(ctx.lead.sessionId)
  ) {
    console.log('');
    console.log('  ⚠ no ping follower armed — notify/ask from these workers will not reach you.');
    console.log('    arm it once per session:  coagent pings --follow');
  }
}

async function cmdWaitAll(cli) {
  const ctx = resolveContext(cli, { create: false });
  const leadSessionId = ctx.lead.sessionId;
  const timeoutSec = cli.timeoutSec != null ? cli.timeoutSec : DEFAULT_WAIT_SEC;
  const deadline = Date.now() + timeoutSec * 1000;
  const names = listAgentNames(leadSessionId);
  if (!names.length) { console.log('co-agent: no colleagues'); return; }

  const tracked = new Map();
  for (const name of names) {
    for (const it of S.liveItems(STATE_DIR, agentKey(leadSessionId, name))) tracked.set(it.id, name);
  }
  if (!tracked.size) { console.log('co-agent: all idle'); return; }

  // Print each colleague's answer the moment it lands, not at the end.
  const printed = new Set();
  const drain = () => {
    for (const [id, name] of tracked) {
      if (printed.has(id)) continue;
      const it = S.findItem(STATE_DIR, agentKey(leadSessionId, name), id);
      if (!itemSettled(it)) continue;
      printed.add(id);
      console.log(`@${name}`);
      printConsult(it, { full: true });
    }
    return printed.size === tracked.size;
  };

  while (Date.now() < deadline) {
    for (const name of names) await reap(agentKey(leadSessionId, name));
    if (drain()) break;
    await sleep(300);
  }
  drain();
  const pending = [...tracked].filter(([id]) => !printed.has(id));
  if (pending.length) {
    fail(`timed out after ${timeoutSec}s — still working: ${[...new Set(pending.map(([, n]) => `@${n}`))].join(', ')}`);
  }
}

function cmdSessions(cli) {
  const ctx = resolveContext(cli, { create: false });
  const key = ctx.key;
  const meta = S.loadMeta(STATE_DIR, key);
  const roster = S.loadRoster(STATE_DIR, key);
  if (meta.sessionId && !roster.sessions.some((s) => s.id === meta.sessionId)) {
    roster.sessions = [{ id: meta.sessionId, createdAt: meta.createdAt, cwd: meta.cwd, model: meta.model }, ...roster.sessions];
  }
  if (!roster.sessions.length) {
    console.log('no inner sessions yet');
    return;
  }
  for (const s of roster.sessions) {
    const mark = s.id === meta.sessionId ? '*' : ' ';
    const info = ctx.ha.describeSession(ctx.ha.sessionPaths(s.id, s.cwd || ctx.cwd));
    console.log(
      `${mark} ${s.id}` +
      `${info.title ? `  ${info.title}` : ''}` +
      `${s.model || info.modelId ? `  ${s.model || info.modelId}` : ''}` +
      `${s.createdAt ? `  ${ageLabel(s.createdAt)}` : ''}`,
    );
  }
}

function cmdResume(cli, id) {
  if (!id) fail('usage: coagent resume <session-id>');
  const ctx = resolveContext(cli);
  const key = ctx.key;
  S.reapStale(STATE_DIR, key);
  if (S.busy(STATE_DIR, key)) fail('busy — stop first, then resume');
  const roster = S.loadRoster(STATE_DIR, key);
  const meta = S.loadMeta(STATE_DIR, key);
  const prior = roster.sessions.find((s) => s.id === id);
  const cwd = (prior && prior.cwd) || meta.cwd || ctx.cwd;
  const known = !!prior || meta.sessionId === id
    || !!sessionPaths(id, cwd).transcript;
  if (!known) fail(`unknown inner session: ${id}`);
  S.addToRoster(STATE_DIR, key, { id, cwd, model: ctx.model, harness: ctx.ha.id });
  S.clearInbox(STATE_DIR, key);
  S.saveMeta(STATE_DIR, key, { ...meta, sessionId: id, cwd, lastError: null });
  console.log(`co-agent: resumed ${id}`);
}

function clearAsksFrom(leadSessionId, agentName) {
  const dir = asksDir(pingsPath(leadSessionId));
  if (!fs.existsSync(dir)) return;
  for (const f of fs.readdirSync(dir)) {
    if (!f.endsWith('.json')) continue;
    const q = S.readJson(path.join(dir, f), null);
    if (!q || q.from !== agentName) continue;
    try { fs.rmSync(path.join(dir, f), { force: true }); } catch { /* */ }
    try { fs.rmSync(path.join(dir, `${q.id}.answer`), { force: true }); } catch { /* */ }
  }
}

function cmdReset(cli) {
  const ctx = resolveContext(cli);
  const key = ctx.key;
  S.reapStale(STATE_DIR, key);
  if (S.busy(STATE_DIR, key)) fail('busy — stop first, then reset');
  const meta = S.loadMeta(STATE_DIR, key);
  const old = meta.sessionId;
  if (old) S.addToRoster(STATE_DIR, key, { id: old, cwd: meta.cwd || ctx.cwd, model: meta.model, harness: meta.harness || ctx.ha.id });
  S.clearInbox(STATE_DIR, key);
  // Pings are the lead's shared log. Resetting one tape must not erase them.
  clearAsksFrom(ctx.lead.sessionId, ctx.agentName);
  S.saveMeta(STATE_DIR, key, {
    ...S.emptyMeta(),
    harness: ctx.ha.id,
    cwd: ctx.cwd,
    access: ctx.access,
    model: ctx.model,
    effort: ctx.effort,
    agent: ctx.agent,
  });
  const who = ctx.agentName === DEFAULT_AGENT ? '' : `@${ctx.agentName} `;
  if (!old) {
    console.log(`co-agent: ${who}no inner session yet — next send starts one`);
    return;
  }
  console.log(`co-agent: reset ${who} archived ${old}`);
  console.log(`  old tape kept. resume it with: coagent ${who}resume ${old}`);
}

function cmdLog(cli) {
  const ctx = resolveContext(cli, { create: false });
  const inbox = S.loadInbox(STATE_DIR, ctx.key);
  if (!inbox.length) { console.log('no consults yet'); return; }
  const items = [...inbox].sort((a, b) => (
    String(a.startedAt || a.createdAt || '').localeCompare(String(b.startedAt || b.createdAt || ''))
  ));
  for (const i of items) printConsult(i, { full: true });
}

async function cmdWatch(cli) {
  const ctx = resolveContext(cli, { create: false });
  const key = ctx.key;
  const follow = !!cli.follow;
  const tape = innerTape(ctx);
  const p = tape.paths.transcript;
  console.error(`watching ${tape.sessionId || '(waiting)'} · ${p || '(no tape yet)'} · follow=${follow}`);
  const pump = makeUpdatePump(ctx);

  for (;;) {
    S.reapStale(STATE_DIR, key);
    pump();
    const stillBusy = S.busy(STATE_DIR, key);
    if (!follow && !stillBusy) {
      pump();
      console.log('_(idle)_');
      return;
    }
    await sleep(400);
  }
}

function cmdDoctor() {
  console.log(`home:     ${ROOT}`);
  console.log(`persona:  ${fs.existsSync(PERSONA_FILE) ? PERSONA_FILE : 'MISSING'}`);
  console.log(`state:    ${STATE_DIR}`);
  const r = H.resolve();
  if (r.error) {
    console.log(`harness:  (none) — ${r.error}`);
    for (const a of H.ADAPTERS) console.log(`  ${a.id}: bin=${H.resolveBin(a)}  home=${a.home}`);
    return;
  }
  const { harness: ha, lead } = r;
  console.log(`harness:  ${ha.id} (${ha.label})`);
  console.log(`bin:      ${H.resolveBin(ha)}`);
  for (const a of H.ADAPTERS) {
    if (a.id === ha.id) continue;
    console.log(`  also:    ${a.id} bin=${H.resolveBin(a)}`);
  }
  console.log(`lead:     ${lead.sessionId}  pin=${lead.pin}`);
  console.log(`history:  ${lead.transcriptPath || '(none)'}`);
  if (lead.contextPath) console.log(`context:  ${lead.contextPath}`);
}

async function main() {
  const parsed = parseArgs(process.argv.slice(2));
  if (parsed.help) { printHelp(); return; }
  const cli = {
    model: parsed.model,
    effort: parsed.effort,
    follow: parsed.follow,
    timeoutSec: parsed.timeoutSec,
    agentName: parsed.agentName,
    all: parsed.all,
    cwd: parsed.cwd,
    access: parsed.access,
  };
  const brief = parsed.briefFile ? readBrief(parsed.briefFile) : null;
  // A brief replaces the message, so inline text alongside it is ambiguous
  // about which one the worker should act on.
  const sendText = (verbArgs) => {
    const inline = verbArgs.join(' ').trim();
    if (brief && inline) fail('pass the message inline or with --brief-file, not both');
    return brief || inline;
  };

  if (parsed.worker || process.env.COAGENT_BG_WORKER === '1') {
    const ctx = resolveContext(cli);
    await becomeWorkerAndDrain(ctx);
    return;
  }

  const rest = parsed.rest;
  const verb = rest[0];

  const WORKER_VERBS = new Set(['notify', 'ask', 'pings']);
  if (process.env.COAGENT_PING_FILE && !WORKER_VERBS.has(verb)) {
    fail(`you are a co-agent — only ${[...WORKER_VERBS].join(', ')} are available to you`);
  }

  if (!verb) return brief ? await cmdSend(brief, cli, { later: false }) : cmdStatus(cli);

  if (verb === 'notify') return cmdNotify(sendText(rest.slice(1)));
  if (verb === 'ask') return await cmdAsk(cli, sendText(rest.slice(1)));
  if (verb === 'answer') return cmdAnswer(rest[1], sendText(rest.slice(2)));
  if (verb === 'asks') return cmdAsks(cli, rest[1]);
  if (verb === 'pings') return await cmdPings(cli);
  if (verb === 'help') { printHelp(); return; }
  if (verb === 'status') return cmdStatus(cli);
  if (verb === 'later') return await cmdSend(sendText(rest.slice(1)), cli, { later: true });
  if (verb === 'now') return await cmdSend(sendText(rest.slice(1)), cli, { later: false });
  if (verb === 'stop') return await cmdStop(cli);
  if (verb === 'wait') return cli.all ? await cmdWaitAll(cli) : await cmdWait(cli, rest[1]);
  if (verb === 'agents') return cmdAgents(cli);
  if (verb === 'watch') return await cmdWatch(cli);
  if (verb === 'log') return cmdLog(cli);
  if (verb === 'reset') return cmdReset(cli);
  if (verb === 'sessions') return cmdSessions(cli);
  if (verb === 'resume') return cmdResume(cli, rest[1]);
  if (verb === 'doctor') return cmdDoctor();

  if (VERBS.has(verb) === false && !verb.startsWith('-')) {
    return await cmdSend(sendText(rest), cli, { later: false });
  }
  fail(`unknown command ${verb}  (try --help)`);
}

if (require.main === module) {
  main().catch((e) => fail(e && e.stack ? e.stack : String(e)));
}

module.exports = {
  parseArgs,
  resolveEffort,
  resolveWorkdir,
  resolveAccess,
  resumeDecision,
  buildRules,
  parseResult,
  loadPersona,
  DEFAULT_WAIT_SEC,
};
